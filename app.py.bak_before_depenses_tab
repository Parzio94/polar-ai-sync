    f = POLAR / "nutrition_config.json"
    default = {"poids_kg":72,"taille_cm":178,"age_ans":28,"sexe":"M","bmr_override":None,
               "objectif_prot_g_par_kg":1.8,"objectif_carb_base_g":300,"objectif_fat_base_g":70}
    if not f.exists():
        f.write_text(json.dumps(default, indent=2))
    try:
        return {**default, **json.loads(f.read_text())}
    except:
        return default

def get_daily_needs(date_str, log_data=None):
    """
    Calcule les besoins caloriques du jour en fonction du BMR + sport + déjeuner confirmé.
    """
    config = load_nutrition_config()
    bmr = calc_bmr(config)

    # Sport du jour depuis week_current.json
    kcal_sport = 0
    sport_label = None
    try:
        wc = json.loads((POLAR / "data/weeks/week_current.json").read_text())
        for ex in wc.get("exercises", []):
            ex_date = (ex.get("start_time") or ex.get("start-time",""))[:10]
            if ex_date == date_str and ex.get("kcal"):
                kcal_sport += int(ex["kcal"])
                sp = ex.get("sport","").upper()
                icon = "🏃" if "RUNNING" in sp else "🚴" if "CYCL" in sp else "🏊" if "SWIM" in sp else "💪"
                dur = ex.get("duration","")
                sport_label = f"{icon} {dur}" if dur else icon
    except Exception:
        pass

    kcal_total_burned = bmr + kcal_sport
    kcal_target = kcal_total_burned + 200
    prot_target = round(config["poids_kg"] * config["objectif_prot_g_par_kg"], 1)
    carb_target = config["objectif_carb_base_g"] + (kcal_sport // 500) * 30
    fat_target  = config["objectif_fat_base_g"]

    # Déjeuner confirmé
    lunch = None
    if log_data:
        lunch = next((e for e in log_data if e.get("date") == date_str and e.get("meal") == "lunch"), None)

    reste = None
    if lunch:
        reste = {
            "kcal":   round(kcal_target - lunch.get("kcal",0)),
            "prot_g": round(prot_target  - lunch.get("prot_g",0), 1),
            "carb_g": round(carb_target  - lunch.get("carb_g",0), 1),
            "fat_g":  round(fat_target   - lunch.get("fat_g",0),  1),
        }

    return {
        "bmr": round(bmr),
        "kcal_sport": kcal_sport,
        "sport_label": sport_label,
        "kcal_total_burned": round(kcal_total_burned),
        "kcal_target": round(kcal_target),
        "prot_target": prot_target,
        "carb_target": carb_target,
        "fat_target": fat_target,
        "lunch": lunch,
        "reste": reste,
    }

