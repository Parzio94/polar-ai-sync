def parse_duration(s):
    if not s: return 0
    s=str(s)
    # Format ISO : PT1H23M45S
    m=re.match(r'PT(?:(\d+)H)?(?:(\d+)M)?(?:([\d.]+)S)?',s)
    if m: return int(m.group(1) or 0)*3600+int(m.group(2) or 0)*60+float(m.group(3) or 0)
    # Format lisible : "55min 55s" ou "1h 23min 45s"
    total=0
    mh=re.search(r'(\d+)h',s); total+=int(mh.group(1))*3600 if mh else 0
    mm=re.search(r'(\d+)min',s); total+=int(mm.group(1))*60 if mm else 0
    ms=re.search(r'(\d+)s',s); total+=int(ms.group(1)) if ms else 0
    if total: return total
    # Fallback : duration_s direct (int)
    try: return int(s)
    except: return 0

def normalize_exercise(ex):
    """
    Normalise un exercice vers le format kebab-case unifié.
    polar_daily.py produit du snake_case (start_time, heart_rate, …)
    L'ancien système produisait du kebab-case (start-time, heart-rate, …)
    Cette fonction accepte les deux et retourne toujours le kebab-case.
    """
    if not isinstance(ex, dict):
        return ex
    # Déjà normalisé si start-time présent
    # start-time present but continue to fill missing fields
    pass  # do not short-circuit
    e = dict(ex)
    # ── Format A : start_time → start-time ──────────────────────
    if e.get("start_time") and not e.get("start-time"):
        e["start-time"] = e["start_time"]
    # ── Format A : heart_rate{} → heart-rate + hr_avg/hr_max ────
    if isinstance(e.get("heart_rate"), dict) and not e.get("heart-rate"):
        e["heart-rate"] = e["heart_rate"]
        if not e.get("hr_avg"):
            e["hr_avg"] = e["heart_rate"].get("average")
        if not e.get("hr_max"):
            e["hr_max"] = e["heart_rate"].get("maximum")
    # ── Format A : distance float → distance_m int ──────────────
    if e.get("distance") is not None and not e.get("distance_m"):
        e["distance_m"] = int(e["distance"])
    # ── Format A : calories → kcal ──────────────────────────────
    if e.get("calories") and not e.get("kcal"):
        e["kcal"] = e["calories"]
    # ── Format A : fat/carb_percentage → kcal_fat/carb_pct ─────
    if e.get("fat_percentage") is not None and not e.get("kcal_fat_pct"):
        e["kcal_fat_pct"] = e["fat_percentage"]
    if e.get("carbohydrate_percentage") is not None and not e.get("kcal_carb_pct"):
        e["kcal_carb_pct"] = e["carbohydrate_percentage"]
    # ── Format A : running_index → vo2max ───────────────────────
    if e.get("running_index") is not None and not e.get("vo2max"):
        e["vo2max"] = e["running_index"]
    # ── Format A : training_load_pro → cardio_load/muscle_load ──
    if not e.get("cardio_load") and isinstance(e.get("training_load_pro"), dict):
        tl = e["training_load_pro"]
        cl = tl.get("cardio-load") or tl.get("cardio_load")
        ml = tl.get("muscle-load") or tl.get("muscle_load") or -1
        e["cardio_load"]       = round(float(cl), 1) if cl else None
        e["cardio_load_level"] = tl.get("cardio-load-interpretation") or tl.get("cardio_load_level")
        e["muscle_load"]       = round(float(ml), 1) if ml and float(ml) > 0 else None
        e["muscle_load_level"] = (tl.get("muscle-load-interpretation") or tl.get("muscle_load_level")) if e.get("muscle_load") else None
    # Champs principaux
    if e.get("start_time") and not e.get("start-time"):
        e["start-time"] = e["start_time"]
    # Normaliser POOL_SWIMMING → SWIMMING
    if e.get("sport") == "POOL_SWIMMING":
        e["sport"] = "POOL_SWIMMING"  # garde pour affichage mais traiter comme SWIMMING
        e["_is_swimming"] = True
    if e.get("sport") in ("SWIMMING", "POOL_SWIMMING"):
        e["_is_swimming"] = True
    # distance_m → distance (en mètres) pour natation
    if e.get("distance_m") and not e.get("distance"):
        e["distance"] = e["distance_m"]
    # pace_100m → allure natation
    if e.get("pace_100m") and not e.get("_pace_swim"):
        e["_pace_swim"] = e["pace_100m"]
    # week_*.json : date seule → reconstruire start-time si besoin
    if e.get("date") and not e.get("start-time"):
        e["start-time"] = e["date"] + "T00:00:00"
    if e.get("heart_rate") and not e.get("heart-rate"):
        e["heart-rate"] = e["heart_rate"]
    if e.get("training_load_pro") and not e.get("training-load-pro"):
        tl = e["training_load_pro"]
        # snake_case interne aussi : cardio_load → cardio-load
        if isinstance(tl, dict):
            tl2 = {}
            for k, v in tl.items():
                tl2[k.replace("_", "-")] = v
            e["training-load-pro"] = tl2
        else:
            e["training-load-pro"] = tl
    if e.get("running_index") is not None and not e.get("running-index"):
        e["running-index"] = e["running_index"]
    if e.get("fat_percentage") is not None and not e.get("fat-percentage"):
        e["fat-percentage"] = e["fat_percentage"]
    if e.get("carbohydrate_percentage") is not None and not e.get("carbohydrate-percentage"):
        e["carbohydrate-percentage"] = e["carbohydrate_percentage"]
    if e.get("protein_percentage") is not None and not e.get("protein-percentage"):
        e["protein-percentage"] = e["protein_percentage"]
    if e.get("has_route") is not None and not e.get("has-route"):
        e["has-route"] = e["has_route"]
    if e.get("detailed_sport_info") and not e.get("detailed-sport-info"):
        e["detailed-sport-info"] = e["detailed_sport_info"]
    # Splits depuis _km_splits (format polar_daily) → _splits_km (format app)
    if e.get("_km_splits") and not e.get("_splits_km"):
        raw = e["_km_splits"]
        converted = []
        for s in raw:
            converted.append({
                "km":      s.get("km"),
                "pace":    s.get("pace",""),
                "hr_avg":  s.get("hr_avg") or s.get("avg_hr"),
                "hr_min":  s.get("hr_min"),
                "hr_max":  s.get("hr_max"),
                "cadence": s.get("cadence") or s.get("avg_cad"),
                "pwr_avg": s.get("pwr_avg") or s.get("power_avg"),
                "pwr_max": s.get("pwr_max") or s.get("power_max"),
                "d_plus":  s.get("d_plus"),
                "d_minus": s.get("d_minus"),
                "d_net":   s.get("d_net"),
            })
        e["_splits_km"] = converted
    # Format B : splits → _splits_km
    # polar_daily: cadence + pwr_avg directs ; polar_consolidate: cadence_spm + power_avg
    if e.get("splits") and not e.get("_splits_km"):
        e["_splits_km"] = [{
            "km":      s.get("km"),
            "pace":    s.get("pace"),
            "hr_avg":  s.get("hr_avg"),
            "hr_min":  s.get("hr_min"),
            "hr_max":  s.get("hr_max"),
            "cadence": s.get("cadence_spm") or s.get("cadence"),
            "pwr_avg": s.get("power_avg") or s.get("pwr_avg"),
            "pwr_max": s.get("power_max") or s.get("pwr_max"),
            "d_plus":  s.get("d_plus"),
            "d_minus": s.get("d_minus"),
            "d_net":   s.get("d_net"),
        } for s in e["splits"]]
    # Elevation depuis _elevation (Format A) ou champs (Format B)
    if not e.get("_elevation"):
        if e.get("elevation_up_m") or e.get("elevation_down_m"):
            e["_elevation"] = {"d_plus": e.get("elevation_up_m"), "d_minus": e.get("elevation_down_m")}
    # Champs du nouveau format week_*.json → compatibilité affichage
    if e.get("hr_avg") and not e.get("heart-rate"):
        e["heart-rate"] = {"average": e["hr_avg"], "maximum": e.get("hr_max")}
    if e.get("kcal") and not e.get("calories"):
        e["calories"] = e["kcal"]
    if e.get("kcal_fat_pct") is not None and not e.get("fat-percentage"):
        e["fat-percentage"] = e["kcal_fat_pct"]
    if e.get("kcal_carb_pct") is not None and not e.get("carbohydrate-percentage"):
        e["carbohydrate-percentage"] = e["kcal_carb_pct"]
    if e.get("vo2max") and not e.get("running-index"):
        e["running-index"] = e["vo2max"]
    if e.get("pace_100m") and not e.get("_pace_swim"):
        e["_pace_swim"] = e["pace_100m"]
    if e.get("distance_km") and not e.get("distance"):
        e["distance"] = e["distance_km"] * 1000
    if e.get("duration_s") and not e.get("duration"):
        _s = int(e["duration_s"])
        e["duration"] = f"PT{_s//3600}H{(_s%3600)//60}M{_s%60}S"

    # ── Remonter power_avg / cadence_avg / pace_avg depuis splits si absents ──
    _src_splits = e.get("_splits_km") or e.get("splits") or []
    if _src_splits:
        # power_avg
        if not e.get("power_avg"):
            _pw = [s.get("pwr_avg") or s.get("power_avg") for s in _src_splits if s.get("pwr_avg") or s.get("power_avg")]
            if _pw: e["power_avg"] = round(sum(_pw) / len(_pw))
        # power_max
        if not e.get("power_max"):
            _pm = [s.get("pwr_max") or s.get("power_max") for s in _src_splits if s.get("pwr_max") or s.get("power_max")]
            if _pm: e["power_max"] = max(_pm)
        # cadence_avg
        if not e.get("cadence_avg"):
            _cd = [s.get("cadence") or s.get("cadence_spm") for s in _src_splits if s.get("cadence") or s.get("cadence_spm")]
            if _cd: e["cadence_avg"] = round(sum(_cd) / len(_cd))
        # pace_avg + pace_best depuis les splits complets (non partiels)
        if not e.get("pace_avg"):
            _full = [s for s in _src_splits if s.get("pace") and "*" not in str(s.get("km",""))]
            _ps = []
            for s in _full:
                try:
                    pp = str(s["pace"]).split(":")
                    _ps.append(int(pp[0])*60 + int(pp[1]))
                except: pass
            if _ps:
                _avg_s = round(sum(_ps) / len(_ps))
                e["pace_avg"] = f"{_avg_s//60}:{_avg_s%60:02d}"
                e["pace_best"] = f"{min(_ps)//60}:{min(_ps)%60:02d}"
        # hr_avg depuis splits si absent
        if not e.get("hr_avg"):
            _hr = [s.get("hr_avg") for s in _src_splits if s.get("hr_avg")]
            if _hr: e["hr_avg"] = round(sum(_hr) / len(_hr))
        # elevation depuis splits si absent
        if not e.get("elevation_up_m"):
            _dp = sum(s.get("d_plus") or 0 for s in _src_splits)
            _dm = sum(s.get("d_minus") or 0 for s in _src_splits)
            if _dp: e["elevation_up_m"] = round(_dp)
            if _dm: e["elevation_down_m"] = round(_dm)
            if _dp or _dm:
                e["_elevation"] = {"d_plus": round(_dp) if _dp else None, "d_minus": round(_dm) if _dm else None}

    return e

def fmt_dur(s):
    if not s: return '—'
    s=int(s); h,r=divmod(s,3600); m,sec=divmod(r,60)
    if h: return f"{h}h {m:02d}min {sec:02d}s"
    return f"{m}min {sec:02d}s"

def fmt_hm(s):
    if not s: return '—'
    s=int(s); return f"{s//3600}h{(s%3600)//60:02d}" if s>=3600 else f"{s//60}min"

def allure(secs,dist_m):
    if not secs or not dist_m: return '—'
    a=secs/dist_m*1000/60
    return f"{int(a)}:{int((a%1)*60):02d}/km"

def get_week_key(date_str):
    try:
        d=datetime.strptime(date_str[:10],"%Y-%m-%d")
        return (d-timedelta(days=d.weekday())).strftime("%Y-%m-%d")
    except: return date_str[:10]

def load_exercises():
    """
    Source UNIQUE : week_current.json (Format A) + week_2*.json (Format B ou minimal).
    Zéro lecture sync_*.json.
    """
    seen, exs = set(), []
    weeks_dir = DATA / "weeks"
    if not weeks_dir.exists():
        return []

    def _norm_sport(s):
        return "CYCLING" if s == "ROAD_BIKING" else s

    # 1. week_current.json — semaine active (Format A, polar_daily enrichi)
    week_current = weeks_dir / "week_current.json"
    if week_current.exists():
        try:
            wd = json.loads(week_current.read_text())
            for e in wd.get("exercises", []):
                e = normalize_exercise(e)
                k = e.get("start-time", "")[:19] + "_" + _norm_sport(e.get("sport", "?"))
                if k and k not in seen:
                    seen.add(k)
                    exs.append(enrich_exercise_splits(e))
        except Exception:
            pass

    # 2. week_2*.json — semaines passées (Format B ou minimal)
    for wf in sorted(weeks_dir.glob("week_2*.json"), reverse=True):
        try:
            wd = json.loads(wf.read_text())
            for e in wd.get("exercises", []):
                e = normalize_exercise(e)
                if not e.get("start-time") and e.get("date"):
                    e["start-time"] = e["date"] + "T00:00:00"
                k = e.get("start-time", "")[:19] + "_" + _norm_sport(e.get("sport", "?"))
                if k and k not in seen:
                    seen.add(k)
                    exs.append(enrich_exercise_splits(e))
        except Exception:
            pass

    return sorted(exs, key=lambda e: e.get("start-time", ""), reverse=True)

def load_sleep_recharge():
    """
    Source UNIQUE : week_current.json (Format A enrichi) + week_2*.json (Format B).
    Zéro lecture sync_*.json.

    Format A (week_current après fix polar_daily) :
      sleep_score, total_sleep_minutes, light_sleep/deep_sleep/rem_sleep (secondes),
      total_interruption_duration, sleep_cycles, continuity,
      heart_rate_avg, heart_rate_min, nightly_recharge_status,
      group_duration_score, group_solidity_score, group_regeneration_score

    Format B (week_2*.json consolidés) :
      score, total_min, phases{deep_min, light_min, rem_min, interruptions_min},
      hr_avg, hr_min, recharge_status, recharge_score, breathing_avg
    """
    sn, rc = {}, {}
    weeks_dir = DATA / "weeks"
    if not weeks_dir.exists():
        return [], []

    def normalize_night_A(n):
        """Format A (polar_daily brut enrichi) → format unifié app."""
        n2 = dict(n)
        if n2.get("sleep_score") and not n2.get("score"):
            n2["score"] = n2["sleep_score"]
        if n2.get("total_sleep_minutes") and not n2.get("total_min"):
            n2["total_min"] = n2["total_sleep_minutes"]
        if not n2.get("phases"):
            n2["phases"] = {
                "deep_min":          round(n2["deep_sleep"] / 60)  if n2.get("deep_sleep")               else None,
                "light_min":         round(n2["light_sleep"] / 60) if n2.get("light_sleep")              else None,
                "rem_min":           round(n2["rem_sleep"] / 60)   if n2.get("rem_sleep")                else None,
                "interruptions_min": round(n2["total_interruption_duration"] / 60) if n2.get("total_interruption_duration") else None,
            }
        if n2.get("heart_rate_avg") and not n2.get("hr_avg"):
            n2["hr_avg"] = n2["heart_rate_avg"]
        return n2

    def normalize_night_B(n):
        """Format B (polar_consolidate) → format unifié app."""
        n2 = dict(n)
        if n2.get("score") and not n2.get("sleep_score"):
            n2["sleep_score"] = n2["score"]
        if n2.get("total_min") and not n2.get("total_sleep_minutes"):
            n2["total_sleep_minutes"] = n2["total_min"]
        if n2.get("hr_avg") and not n2.get("heart_rate_avg"):
            n2["heart_rate_avg"] = n2["hr_avg"]
        if n2.get("hr_min") and not n2.get("heart_rate_min"):
            n2["heart_rate_min"] = n2["hr_min"]
        if n2.get("recharge_status") and not n2.get("nightly_recharge_status"):
            n2["nightly_recharge_status"] = n2["recharge_status"]
        if n2.get("breathing_avg") and not n2.get("breathing_rate_avg"):
            n2["breathing_rate_avg"] = n2["breathing_avg"]
        # cycles → sleep_cycles
        if n2.get("cycles") and not n2.get("sleep_cycles"):
            n2["sleep_cycles"] = n2["cycles"]
        # hrv_sdnn → heart_rate_variability_avg
        if n2.get("hrv_sdnn") and not n2.get("heart_rate_variability_avg"):
            n2["heart_rate_variability_avg"] = n2["hrv_sdnn"]
        ph = n2.get("phases") or {}
        if ph.get("deep_min") and not n2.get("deep_sleep"):
            n2["deep_sleep"]                 = int(ph["deep_min"] * 60)
        if ph.get("light_min") and not n2.get("light_sleep"):
            n2["light_sleep"]                = int(ph["light_min"] * 60)
        if ph.get("rem_min") and not n2.get("rem_sleep"):
            n2["rem_sleep"]                  = int(ph["rem_min"] * 60)
        if ph.get("interruptions_min") and not n2.get("total_interruption_duration"):
            n2["total_interruption_duration"] = int(ph["interruptions_min"] * 60)
        return n2

    # 1. week_current.json — semaine active (Format A)
    week_current = weeks_dir / "week_current.json"
    if week_current.exists():
        try:
            wd = json.loads(week_current.read_text())
            for n in wd.get("sleep", []):
                k = n.get("date", "")
                if k and k not in sn:
                    sn[k] = normalize_night_A(n)
            for r in wd.get("recharge", []):
                k = r.get("date", "")
                if k and k not in rc:
                    rc[k] = r
        except Exception:
            pass

    # 2. week_2*.json — semaines passées (Format B)
    for wf in sorted(weeks_dir.glob("week_2*.json"), reverse=True):
        try:
            wd = json.loads(wf.read_text())
            for n in wd.get("sleep", []):
                k = n.get("date", "")
                if k and k not in sn:
                    n2 = normalize_night_B(n)
                    sn[k] = n2
                    if k not in rc and (n2.get("heart_rate_avg") or n2.get("nightly_recharge_status")):
                        rc[k] = {
                            "date":                    k,
                            "nightly_recharge_status": n2.get("nightly_recharge_status"),
                            "heart_rate_avg":          n2.get("heart_rate_avg"),
                            "breathing_rate_avg":      n2.get("breathing_rate_avg"),
                            "score":                   n2.get("recharge_score"),
                            "heart_rate_variability_avg": n2.get("heart_rate_variability_avg") or n2.get("hrv_sdnn"),
                        }
        except Exception:
            pass

    return (sorted(sn.values(), key=lambda x: x.get("date", ""), reverse=True),
            sorted(rc.values(), key=lambda x: x.get("date", ""), reverse=True))

