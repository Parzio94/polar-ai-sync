def get_micronutrients_day(date_str):
    """Calcule les apports en micronutriments du jour depuis supplements_config.json."""
    config = load_micronutrients_config()
    if not config:
        return {}
    try:
        dow = datetime.strptime(date_str, "%Y-%m-%d").weekday()
    except Exception:
        dow = now_local().weekday()
    exercises = load_exercises()
    has_training = any(
        (e.get("start-time","") or e.get("start_time","")).startswith(date_str)
        for e in exercises
    )
    CAFEINE_KEY = "cafeine_mg"
    supp_totals = {}
    for supp in config.get("supplements", []):
        taken_on = supp.get("taken_on", "daily")
        actif = (
            taken_on == "daily" or
            (taken_on == "schedule" and dow in supp.get("schedule_dow", [])) or
            (taken_on == "training" and has_training)
        )
        if not actif:
            continue
        for key, val in supp.get("doses", {}).items():
            if val is None:
                continue
            if key == CAFEINE_KEY:
                supp_totals[key] = supp_totals.get(key, 0) + val
            else:
                supp_totals[key] = max(supp_totals.get(key, 0), val)
    log_data = load_nutrition_log()
    kcal_alim = carb_alim = 0
    for entry in log_data:
        if entry.get("date") == date_str:
            kcal_alim += entry.get("kcal", 0)
            carb_alim += entry.get("carb_g", 0)
    UNITS = {
        "huile_poisson_mg":"mg","epa_mg":"mg","dha_mg":"mg",
        "cafeine_mg":"mg","taurine_mg":"mg","beta_alanine_mg":"mg",
        "l_theanine_mg":"mg","vinitrox_mg":"mg","guarana_mg":"mg",
        "damiana_mg":"mg","eleutherocoques_mg":"mg","cordyceps_mg":"mg",
        "nac_mg":"mg","quercetine_mg":"mg","coenzyme_q10_mg":"mg","luteine_mg":"mg",
        "magnesium_mg":"mg","zinc_mg":"mg","vitamine_c_mg":"mg","vitamine_e_mg":"mg",
        "vitamine_b1_mg":"mg","vitamine_b2_mg":"mg","vitamine_b3_mg":"mg",
        "vitamine_b5_mg":"mg","vitamine_b6_mg":"mg","potassium_mg":"mg",
        "vitamine_d3_ug":"µg","vitamine_a_ug":"µg","vitamine_b8_ug":"µg",
        "vitamine_b9_ug":"µg","vitamine_b12_ug":"µg","vitamine_k1_ug":"µg",
        "vitamine_k2_mk7_ug":"µg","selenium_ug":"µg",
    }
    result = {}
    for key, val in supp_totals.items():
        result[key] = {"supp": val, "alim": 0, "unit": UNITS.get(key, "mg")}
    result["calories_kcal"] = {"supp": 0, "alim": kcal_alim, "unit": "kcal"}
    result["glucides_g"]    = {"supp": 0, "alim": carb_alim, "unit": "g"}
    for key in result:
        result[key]["total"] = result[key]["supp"] + result[key]["alim"]
    result["_has_training"] = has_training
    result["_dow"] = dow
    return result

def get_last7_nutrition_stats(today, log_data, exercises):
    """Macros + dépense sport pour les 7 derniers jours."""
    ex_by_date = {}
    for ex in exercises:
        d_ex = (ex.get("start-time","") or ex.get("start_time",""))[:10]
        if d_ex:
            ex_by_date.setdefault(d_ex, []).append(ex)
    rows = []
    for i in range(7):
        d = (datetime.strptime(today, "%Y-%m-%d") - timedelta(days=i)).strftime("%Y-%m-%d")
        day_meals = [e for e in log_data if e.get("date") == d]
        kcal_alim = sum(e.get("kcal",0) for e in day_meals)
        prot_g    = sum(e.get("prot_g",0) for e in day_meals)
        carb_g    = sum(e.get("carb_g",0) for e in day_meals)
        fat_g     = sum(e.get("fat_g",0) for e in day_meals)
        lunch  = next((e for e in day_meals if e.get("meal")=="lunch"), None)
        dinner = next((e for e in day_meals if e.get("meal","dinner")=="dinner" and "label" in e), None)
        if not lunch:
            dej_m = get_dejeuner_macros(d)
            kcal_alim += dej_m["kcal"]; prot_g += dej_m["prot_g"]
            carb_g += dej_m["carb_g"]; fat_g += dej_m["fat_g"]
        day_exs = ex_by_date.get(d, [])
        kcal_sport = sum(int(ex.get("kcal") or ex.get("calories") or 0) for ex in day_exs)
        seances_str = []
        for ex in day_exs:
            dur_s = parse_duration(ex.get("duration_s") or ex.get("duration",""))
            sport = ex.get("sport","")
            ico = get_sport_icon(sport)
            kcal_ex = int(ex.get("kcal") or ex.get("calories") or 0)
            seances_str.append(f"{ico} {fmt_hm(dur_s)} {kcal_ex}kcal" if dur_s else f"{ico} {kcal_ex}kcal")
        rows.append({
            "date": d, "kcal_alim": round(kcal_alim), "kcal_sport": round(kcal_sport),
            "bilan_kcal": round(kcal_alim - kcal_sport),
            "prot_g": round(prot_g,1), "carb_g": round(carb_g,1), "fat_g": round(fat_g,1),
            "lunch_label":  lunch.get("label","") if lunch else "Déj. estimé",
            "dinner_label": dinner.get("label","") if dinner else "—",
            "seances": seances_str, "has_data": bool(day_meals),
        })
    return rows

