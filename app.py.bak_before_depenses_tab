  }catch(e){alert('Erreur réseau : '+e.message);}
  _dragEid=null; _dragVid=null;
}

var _lastHotelCheckin=null;
async function _checkHotelPrefill(vid){
  try{
    const r=await fetch('/api/voyages/list');
    const voyages=await r.json();
    const v=voyages.find(x=>x.id===vid);
    if(!v)return;
    const hotels=(v.elements||[]).filter(e=>e.type==='hotel');
    const lastH=hotels[hotels.length-1];
    if(lastH&&lastH.type_evenement==='checkin'){
      _lastHotelCheckin={nom:lastH.nom||'',ville:lastH.ville||''};
    }else{_lastHotelCheckin=null;}
  }catch(e){_lastHotelCheckin=null;}
}
function _applyHotelPrefill(){
  if(!_lastHotelCheckin)return;
  document.getElementById('el-hotel-nom').value=_lastHotelCheckin.nom;
  document.getElementById('el-hotel-ville').value=_lastHotelCheckin.ville;
  document.getElementById('el-hotel-type').value='checkout';
