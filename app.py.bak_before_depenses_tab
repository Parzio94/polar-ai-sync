def distance_vol_oiseau(coords1, coords2):
    R = 6371
    lat1, lng1 = math.radians(coords1["lat"]), math.radians(coords1["lng"])
    lat2, lng2 = math.radians(coords2["lat"]), math.radians(coords2["lng"])
    dlat = lat2 - lat1; dlng = lng2 - lng1
    a = math.sin(dlat/2)**2 + math.cos(lat1)*math.cos(lat2)*math.sin(dlng/2)**2
    return round(R * 2 * math.asin(math.sqrt(a)), 1)

def geocode_ville(nom):
    import urllib.request, urllib.parse
    query = urllib.parse.quote(nom)
    url = f"https://nominatim.openstreetmap.org/search?q={query}&format=json&limit=1"
    req = urllib.request.Request(url, headers={"User-Agent": "CoachIA/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.loads(r.read())
        if data:
            return {"lat": float(data[0]["lat"]), "lng": float(data[0]["lon"])}
    except Exception as e:
        logging.warning("geocode_ville(%s): %s", nom, e)
    return None

