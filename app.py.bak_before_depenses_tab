def compute_splits_from_samples(samples):
    """Calcule les splits par km depuis les samples Polar bruts.
    Extrait aussi samples_5s (BPM + allure + distance sous-échantillonnés ×5)."""
    sample_map = {}
    for s in samples:
        t = s.get("sample_type", s.get("sample-type"))
        raw = s.get("data", "")
        try: sample_map[int(t)] = list(map(float, raw.split(",")))
        except: pass

    hr      = sample_map.get(0, [])
    speed   = sample_map.get(1, [])   # m/s
    cadence = sample_map.get(2, [])
    alt     = sample_map.get(3, [])
    dist    = sample_map.get(10, [])

    if not dist or len(dist) < 10:
        return None

    n = min(len(hr) or len(dist), len(cadence) or len(dist),
            len(alt) or len(dist), len(dist))
    if speed: n = min(n, len(speed))

    def safe(arr, i, default=0):
        return arr[i] if arr and i < len(arr) else default

    # ── samples_5s : sous-échantillonnage ×5 avec lissage 30s ──────
    bpm_5s       = []
    pace_s_5s    = []  # allure en s/km (running)
    speed_kmh_5s = []  # vitesse en km/h (cycling)
    dist_m_5s    = []
    WINDOW = 30  # secondes pour le lissage

    for i in range(0, n, 5):
        # BPM : moyenne sur 5s
        bpm_vals = [safe(hr, j) for j in range(i, min(i+5, n)) if safe(hr, j) > 0]
        bpm_5s.append(round(sum(bpm_vals)/len(bpm_vals)) if bpm_vals else None)

        # Allure (running) + Vitesse km/h (cycling)
        if speed:
            v_vals = [speed[j] for j in range(max(0, i-WINDOW//2), min(n, i+WINDOW//2)) if speed[j] > 1.5]
            v_avg = sum(v_vals)/len(v_vals) if v_vals else 0
            if v_avg > 1.5:
                ps = round(3600 / v_avg)
                pace_s_5s.append(ps if 150 < ps < 900 else None)
                speed_kmh_5s.append(round(v_avg, 1))
            else:
                pace_s_5s.append(None)
                speed_kmh_5s.append(None)
        else:
            w0 = max(0, i - WINDOW//2)
            w1 = min(n-1, i + WINDOW//2)
            d0 = safe(dist, w0); d1 = safe(dist, w1)
            delta_dist = d1 - d0; delta_time = w1 - w0
            if delta_dist > 2 and delta_time > 0:
                ps = round(delta_time * 1000 / delta_dist)
                pace_s_5s.append(ps if 150 < ps < 900 else None)
                speed_kmh_5s.append(round(delta_dist / delta_time * 3.6, 1))
            else:
                pace_s_5s.append(None)
                speed_kmh_5s.append(None)

        dist_m_5s.append(round(safe(dist, i)))

    splits = []
    km = 1
    km_start = 0

    for i in range(1, n):
        if dist[i] >= km * 1000:
            seg_start = km_start
            seg_end = i
            seg_n = seg_end - seg_start
            if seg_n > 0:
                duration_s = seg_end - seg_start
                allure_min = duration_s // 60
                allure_sec = duration_s % 60

                hr_vals = [safe(hr,j) for j in range(seg_start, seg_end) if safe(hr,j) > 0]
                avg_hr = round(sum(hr_vals)/len(hr_vals)) if hr_vals else None

                cad_vals = [safe(cadence,j) for j in range(seg_start, seg_end) if safe(cadence,j) > 0]
                avg_cad = round(sum(cad_vals)/len(cad_vals)) if cad_vals else None

                dplus  = sum(max(0, safe(alt,j)-safe(alt,j-1)) for j in range(seg_start+1, seg_end))
                dminus = sum(max(0, safe(alt,j-1)-safe(alt,j)) for j in range(seg_start+1, seg_end))
                d_net  = dplus - dminus

                splits.append({
                    "km": km,
                    "pace": f"{allure_min}:{allure_sec:02d}",
                    "hr_avg": avg_hr,
                    "cadence": avg_cad,
                    "d_plus": round(dplus, 1) if dplus > 0.5 else None,
                    "d_minus": round(dminus, 1) if dminus > 0.5 else None,
                    "d_net": round(d_net, 1),
                })
            km_start = i
            km += 1

    # Dernier km partiel
    seg_start = km_start
    seg_end = n
    seg_n = seg_end - seg_start
    if seg_n > 10:
        partial_dist = dist[seg_end-1] - dist[seg_start] if seg_end > seg_start else 0
        duration_s = seg_end - seg_start
        if partial_dist > 50:
            allure_s = round(duration_s * 1000 / partial_dist)
            allure_min = allure_s // 60
            allure_sec = allure_s % 60
        else:
            allure_min = allure_sec = 0

        hr_vals = [safe(hr,j) for j in range(seg_start, seg_end) if safe(hr,j) > 0]
        avg_hr = round(sum(hr_vals)/len(hr_vals)) if hr_vals else None
        cad_vals = [safe(cadence,j) for j in range(seg_start, seg_end) if safe(cadence,j) > 0]
        avg_cad = round(sum(cad_vals)/len(cad_vals)) if cad_vals else None
        dplus  = sum(max(0, safe(alt,j)-safe(alt,j-1)) for j in range(seg_start+1, seg_end))
        dminus = sum(max(0, safe(alt,j-1)-safe(alt,j)) for j in range(seg_start+1, seg_end))

        if partial_dist > 50:
            splits.append({
                "km": f"{km}+",
                "pace": f"{allure_min}:{allure_sec:02d}" if allure_min or allure_sec else None,
                "hr_avg": avg_hr,
                "cadence": avg_cad,
                "d_plus": round(dplus, 1) if dplus > 0.5 else None,
                "d_minus": round(dminus, 1) if dminus > 0.5 else None,
                "d_net": round(dplus - dminus, 1),
            })

    # Résumé global
    all_paces = []
    for s in splits:
        p = s.get("pace")
        if p and ":" in str(p):
            try:
                parts = str(p).split(":")
                all_paces.append(int(parts[0])*60 + int(parts[1]))
            except: pass
    all_hr = [s["hr_avg"] for s in splits if s.get("hr_avg")]
    all_cad = [s["cadence"] for s in splits if s.get("cadence")]
    total_dplus = sum(s.get("d_plus") or 0 for s in splits)
    total_dminus = sum(s.get("d_minus") or 0 for s in splits)

    summary = {}
    if all_paces:
        avg_s = sum(all_paces)//len(all_paces)
        summary["pace_avg"] = f"{avg_s//60}:{avg_s%60:02d}"
        min_s = min(all_paces)
        summary["pace_max"] = f"{min_s//60}:{min_s%60:02d}"
    if all_hr:   summary["hr_avg"] = round(sum(all_hr)/len(all_hr))
    if all_cad:  summary["cadence_avg"] = round(sum(all_cad)/len(all_cad))

    elevation = {}
    if total_dplus > 0: elevation["d_plus"] = round(total_dplus)
    if total_dminus > 0: elevation["d_minus"] = round(total_dminus)

    return {
        "splits": splits,
        "summary": summary,
        "elevation": elevation,
        "samples_5s": {"bpm": bpm_5s, "pace_s": pace_s_5s, "speed_kmh": speed_kmh_5s, "dist_m": dist_m_5s},
    }

def fetch_splits_from_api(exercise_id):
    """Appelle l'API Polar pour récupérer les samples et calculer les splits."""
    import urllib.request
    url = f"https://www.polaraccesslink.com/v3/exercises/{exercise_id}?samples=true"
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {POLAR_TOKEN}", "Accept": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.loads(r.read())
    samples = data.get("samples", [])
    if not samples:
        return None
    return compute_splits_from_samples(samples)

def enrich_exercise_splits(ex):
    """Injecte _splits_km, _samples_summary, _elevation dans l'exercice si dispo."""
    # Déjà enrichi (week file ou chargement précédent)
    if ex.get("_splits_km") is not None:
        return ex
    if ex.get("sport") not in ("RUNNING", "CYCLING", "ROAD_BIKING"):
        return ex

    # Chercher l'ID dans toutes les clés possibles (priorité alphanumérique)
    ex_id = None
    for key in ("polar-exercise-id","exercise-id","exerciseId","id"):
        v = ex.get(key)
        if v:
            s = str(v)
            if s and not s.isdigit():  # ID alphanumérique prioritaire
                ex_id = s; break
    if not ex_id:
        for key in ("id","exercise-id","polar-exercise-id"):
            if ex.get(key): ex_id = str(ex[key]); break

    # 1. Cherche directement par ID
    if ex_id:
        cached = load_splits(ex_id)
        if cached:
            ex["_splits_km"]       = cached.get("splits", [])
            ex["_samples_summary"] = cached.get("summary", {})
            ex["_elevation"]       = cached.get("elevation", {})
            ex["_samples_5s"]      = cached.get("samples_5s", None)
            ex["_ex_id"]           = ex_id
            return ex

    # 2. Fallback : chercher par start-time dans tous les {*}_splits.json
    # (utile quand l'ID dans le sync est numérique mais le fichier est alphanumérique)
    st = ex.get("start-time","")[:16]
    if st:
        for sf in DATA.glob("*_splits.json"):
            try:
                d = json.loads(sf.read_text())
                meta = d.get("meta",{}) or {}
                if meta.get("start_time","")[:16] == st:
                    ex["_splits_km"]       = d.get("splits", [])
                    ex["_samples_summary"] = d.get("summary", {})
                    ex["_elevation"]       = d.get("elevation", {})
                    ex["_samples_5s"]      = d.get("samples_5s", None)
                    ex["_ex_id"]           = sf.stem.replace("_splits","")
                    return ex
            except: pass

    return ex

def parse_swim_distance(duree_str):
    # (?!in) evite de matcher '30min' comme '30m'
    m=re.search(r'(\d+)\s*m(?!in)',str(duree_str))
    return int(m.group(1)) if m else 0

def swim_calc(total_m):
    parts=[round(total_m*r/50)*50 for r in [0.20,0.30,0.40,0.10]]
    parts[2]+=total_m-sum(parts)
    return parts

def swim_desc_serie(m):
    if m>=400 and m%200==0: return f'{m//200}×200m Z2'
    if m>=100 and m%100==0: return f'{m//100}×100m Z2'
    return f'{m//50}×50m Z2'

def swim_structure(total_m):
    e,t,s,rc=swim_calc(total_m)
    return (f'E:{e}m ({e//50}×50) · T:{t}m ({t//50}×50 éduc.) · '
            f'S:{s}m ({swim_desc_serie(s)}) · RC:{rc}m brasse')

def swim_structure_full(total_m):
    e,t,s,rc=swim_calc(total_m)
    return (f'🔵 Échauff. {e}m : {e//50}×50m crawl/dos\n'
            f'🟡 Technique {t}m : {t//50}×50m éducatifs\n'
            f'🟢 Série {s}m : {swim_desc_serie(s)}\n'
            f'⚪ RC {rc}m : brasse facile')

def swim_time_estimate(dist_m, is_technique=False):
    """Estime le temps de nage. Technique = séance longue (~3:00/100m), sinon 2:00/100m."""
    pace_per_100 = 180 if is_technique else 120  # secondes
    total_s = int(dist_m / 100 * pace_per_100)
    h,r=divmod(total_s,3600); m,s=divmod(r,60)
    if h: return f"~{h}h{m:02d}"
    return f"~{m}min"

def enrich_swim(seances):
    result=[]
    for s in seances:
        s2=dict(s)
        if s2.get("sport")=="Natation":
            # Priorité: dist_cible_m depuis JSON (chargé depuis xlsx_to_programme)
            # Fallback: parse depuis champ duree (ancien format)
            dm = s2.get("dist_cible_m") or parse_swim_distance(s2.get("duree",""))
            if dm:
                s2["dist_cible_m"] = dm
                # Structure auto seulement si pas déjà dans le JSON
                if not s2.get("structure") and dm >= 800:
                    s2["structure"] = swim_structure_full(dm)
                    s2["structure_short"] = swim_structure(dm)
        result.append(s2)
    return result

def exercises_by_date_sport(exercises):
    d={}
    for ex in exercises:
        date=ex.get("start-time","")[:10]
        sport=ex.get("sport","")
        # Normaliser ROAD_BIKING → CYCLING
        if sport == "ROAD_BIKING": sport = "CYCLING"
        d[f"{date}_{sport}"]=ex
    return d

def score_badge(score):
    try: sc=int(score)
    except: return "br","Inconnu"
    if sc>=85: return "style=\"background:#7c3aed;color:#fff\"","Ultime"
    if sc>=80: return "bg","Excellent"
    if sc>=75: return "style=\"background:#52b788;color:#fff\"","Très bon"
    if sc>=70: return "by","Bon"
    return "br","Mauvais"

def score_color(score):
    try: sc=int(score)
    except: return "#9ca3af"
    if sc>=85: return "#7c3aed"
    if sc>=80: return "#2d6a4f"
    if sc>=75: return "#52b788"
    if sc>=70: return "#856404"
    return "#e63946"

