async function voyDrop(e,vid,newDate,newMoment){
  e.preventDefault();
  e.currentTarget.style.background='';
  e.currentTarget.style.border='';
  if(!_dragEid||_dragVid!==vid) return;
  try{
    const r=await fetch('/api/voyages/element/move',{method:'POST',
