            adresse = _safe(el.get("adresse",""))
            coords  = el.get("coords")
            titre_parts = ["<b>[Logement]</b>"]
            if heure:  titre_parts.append(f"<b>{heure}</b>")
            if evt:    titre_parts.append(f"<b>{evt} :</b>")
            if nom_el: titre_parts.append(f"<b>{nom_el}</b>")
