@app.route("/api/upload-depenses", methods=["POST"])
def api_upload_depenses():
    """Reçoit un CSV Boursorama, met à jour depenses/mois_YYYY-MM.json (dédoublonné)."""
    try:
        if "file" not in request.files:
            return jsonify({"ok": False, "error": "Aucun fichier reçu"})
        f = request.files["file"]
        if not f.filename or not f.filename.lower().endswith(".csv"):
            return jsonify({"ok": False, "error": "Fichier .csv requis"})

        tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".csv")
        f.save(tmp.name)
        tmp.close()

        import sys as _s
        _s.path.insert(0, str(POLAR))
        import importlib
        import csv_to_depenses as _cd
        importlib.reload(_cd)

        ops = _cd.parse_csv(tmp.name)
        total_new, total_skipped, months = _cd.write_json(ops, _cd.OUTPUT_DIR)

        try:
            os.unlink(tmp.name)
        except Exception:
            pass

        detail = f"{total_new} nouvelle(s) opération(s), {total_skipped} doublon(s) ignoré(s)."
        if months:
            detail += f"\nMois mis à jour : {', '.join(months)}"
        return jsonify({"ok": True, "detail": detail})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)})

