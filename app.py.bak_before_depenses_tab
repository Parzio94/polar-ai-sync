@app.route("/voyages_map")
def voyages_map():
    voyage_id    = request.args.get("id")
    voyages_data = load_voyages()
    voyages      = voyages_data.get("voyages",[])
    if voyage_id:
        voyages = [v for v in voyages if v["id"] == voyage_id]

    type_colors = {"avion":"#1565c0","train":"#6a1b9a","voiture":"#37474f","velo":"#2d6a4f",
                   "ferry":"#006d77","hotel":"#e65100","activite":"#c62828","nourriture":"#f9a825"}
    type_icons  = {"avion":"✈️","train":"🚂","voiture":"🚗","velo":"🚴","ferry":"⛴️",
                   "hotel":"🏨","activite":"🎟️","nourriture":"🍽️"}
    markers = []
    routes  = []

    for v in voyages:
        vcol = v.get("couleur","#52b788")

        # Routes : uniquement en vue détail (un seul voyage), générées par les éléments Transport
        if voyage_id:
            for el in v.get("elements",[]):
                if el.get("type") == "transport":
                    cd = el.get("coords_depart")
                    ca = el.get("coords")
                    if cd and ca:
                        p1 = {"lat":cd["lat"],"lng":cd["lng"],"nom":el.get("ville_depart","")}
                        p2 = {"lat":ca["lat"],"lng":ca["lng"],"nom":el.get("ville_arrivee","")}
                        dist = distance_vol_oiseau({"lat":p1["lat"],"lng":p1["lng"]},{"lat":p2["lat"],"lng":p2["lng"]})
                        routes.append({"pts":[p1,p2],"color":vcol,"dist_km":dist,
                                       "v1":p1["nom"],"v2":p2["nom"]})

        for el in v.get("elements",[]):
            el_type = el.get("type","")
            date    = el.get("date","")
            moment  = el.get("moment","")
            prix_reel = el.get("prix_reel")
            prix    = f"{int(prix_reel)}€" if prix_reel else "—"
            lien    = el.get("lien","")
            if el_type == "transport":
                for ck, vk in [("coords_depart","ville_depart"),("coords","ville_arrivee")]:
                    c = el.get(ck)
                    if c:
                        markers.append({"lat":c["lat"],"lng":c["lng"],
                            "ico":type_icons.get(el.get("mode","avion"),"✈️"),
                            "color":type_colors.get(el.get("mode","avion"),"#1565c0"),
                            "nom":el.get(vk,""),"date":date,"moment":moment,"prix":prix,
                            "statut":el.get("statut","a_reserver"),"resa":el.get("reservation_requise",False),"lien":lien})
            else:
                c = el.get("coords")
                if c:
                    nom_el = el.get("nom", el.get("nom_etablissement",""))
                    markers.append({"lat":c["lat"],"lng":c["lng"],
                        "ico":type_icons.get(el_type,"📌"),
                        "color":type_colors.get(el_type,"#888"),
                        "nom":nom_el,"date":date,"moment":moment,"prix":prix,
                        "statut":el.get("statut",""),"resa":el.get("reservation_requise",False),"lien":lien})

    import json as _json
    # Itineraire pieton par jour avec injection hotel
    from datetime import datetime as _dt, timedelta as _td
    import math as _math
    MOMENT_ORDER = {"matin":0,"midi":1,"aprem":2,"soir":3,"":4}
    DAY_COLORS = ["#e63946","#2d6a4f","#1565c0","#f59e0b","#7c3aed","#006d77","#c62828","#37474f"]
    itinerary_by_day = {}
    if voyage_id:
        _v = next((x for x in load_voyages().get("voyages",[]) if x["id"]==voyage_id), None)
        if _v:
            hotel_periods = []
            for _el in _v.get("elements",[]):
                if _el.get("type") != "hotel": continue
                _evt = _el.get("type_evenement","")
                _c   = _el.get("coords")
                if not _c or not _c.get("lat"): continue
                if _evt == "checkin":
                    hotel_periods.append({"coords":_c,"nom":_el.get("nom",""),"date_in":_el.get("date",""),"date_out":None})
                elif _evt == "checkout" and hotel_periods:
                    for _hp in reversed(hotel_periods):
                        if _hp["date_out"] is None:
                            _hp["date_out"] = _el.get("date",""); break
            day_raw = {}
            for _el in sorted(_v.get("elements",[]), key=lambda e:(e.get("date",""),MOMENT_ORDER.get(e.get("moment",""),4))):
                _etype = _el.get("type","")
                _date  = _el.get("date","")
                if not _date: continue
                if _etype == "hotel" and _el.get("type_evenement","") == "checkout": continue
                if _date not in day_raw: day_raw[_date] = []
                if _etype == "transport":
                    _cd = _el.get("coords_depart"); _ca = _el.get("coords")
                    if _cd and _ca and _cd.get("lat") and _ca.get("lat"):
                        day_raw[_date].append({"lat":_cd["lat"],"lng":_cd["lng"],"nom":_el.get("ville_depart",""),"walk_after":False})
                        day_raw[_date].append({"lat":_ca["lat"],"lng":_ca["lng"],"nom":_el.get("ville_arrivee",""),"walk_after":True})
                else:
                    _c = _el.get("coords")
                    if _c and _c.get("lat"):
                        _nom = _el.get("nom") or _el.get("nom_etablissement","")
                        day_raw[_date].append({"lat":_c["lat"],"lng":_c["lng"],"nom":_nom,"walk_after":True})
            for _hp in hotel_periods:
                if not _hp["date_in"] or not _hp["date_out"]: continue
                try:
                    _d_in  = _dt.strptime(_hp["date_in"],  "%Y-%m-%d")
                    _d_out = _dt.strptime(_hp["date_out"], "%Y-%m-%d")
                    _d = _d_in + _td(days=1)
                    while _d <= _d_out:
                        _ds = _d.strftime("%Y-%m-%d")
                        _hpt = {"lat":_hp["coords"]["lat"],"lng":_hp["coords"]["lng"],"nom":"🏨 "+_hp["nom"],"walk_after":True}
                        if _ds not in day_raw: day_raw[_ds] = [_hpt]
                        else: day_raw[_ds].insert(0, _hpt)
                        _d += _td(days=1)
                except: pass
            def _dist_m(a,b):
                R=6371000; la1,lo1,la2,lo2=map(_math.radians,[a["lat"],a["lng"],b["lat"],b["lng"]])
                return R*_math.acos(min(1,_math.sin(la1)*_math.sin(la2)+_math.cos(la1)*_math.cos(la2)*_math.cos(lo2-lo1)))
            for _di,_date in enumerate(sorted(day_raw.keys())):
                _pts = day_raw[_date]
                _deduped = []
                for _p in _pts:
                    if not _deduped or _dist_m(_deduped[-1], _p) >= 50: _deduped.append(_p)
                if len(_deduped) >= 2:
                    itinerary_by_day[_date] = {"pts":_deduped,"color":DAY_COLORS[_di%len(DAY_COLORS)]}
    markers_json = _json.dumps(markers, ensure_ascii=False)
    routes_json  = _json.dumps(routes,  ensure_ascii=False)
    itinerary_json = _json.dumps(itinerary_by_day, ensure_ascii=False)
    voyage_id_js = voyage_id or ""

    html = f"""<!DOCTYPE html>
<html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
body{{margin:0;padding:0}}
#map{{width:100%;height:100vh}}
#mode-btn{{position:absolute;top:10px;right:10px;z-index:1000;background:#1a1a2e;color:#fff;
  border:none;border-radius:8px;padding:8px 14px;font-size:.8rem;font-weight:700;cursor:pointer}}
#mode-btn.active{{background:#e63946}}
</style>
</head><body>
<div id="map"></div>
<button id="mode-btn" onclick="toggleMode()">➕ Ajouter un point</button>
<script>
const VOYAGE_ID="{voyage_id_js}";
const markers={markers_json};
const routes={routes_json};
const ITINERARY={itinerary_json};
const map=L.map('map');
var _tileLight=L.tileLayer('https://{{s}}.basemaps.cartocdn.com/rastertiles/voyager/{{z}}/{{x}}/{{y}}{{r}}.png',{{attribution:'© OpenStreetMap © CARTO',subdomains:'abcd',maxZoom:19}});
var _tileDark=L.tileLayer('https://{{s}}.basemaps.cartocdn.com/dark_all/{{z}}/{{x}}/{{y}}{{r}}.png',{{attribution:'© OpenStreetMap © CARTO',subdomains:'abcd',maxZoom:19}});
var _darkMode=false;
function toggleMapDark(){{if(_darkMode){{map.removeLayer(_tileDark);_tileLight.addTo(map);document.getElementById('btn-map-dark').textContent='🌙';}}else{{map.removeLayer(_tileLight);_tileDark.addTo(map);document.getElementById('btn-map-dark').textContent='☀️';}} _darkMode=!_darkMode;}}
_tileLight.addTo(map);
// OSRM itineraires pietons
var _routeLayers={{}};
var _osrmCache={{}};
function _hashPts(pts){{return pts.map(function(p){{return p.lat.toFixed(5)+','+p.lng.toFixed(5);}}).join('|');}}
function _loadCache(){{try{{var c=localStorage.getItem('osrm_cache');return c?JSON.parse(c):{{}};}}catch(e){{return{{}};}}}}
function _saveCache(cache){{try{{localStorage.setItem('osrm_cache',JSON.stringify(cache));}}catch(e){{}}}}
_osrmCache=_loadCache();
async function fetchOSRMRoute(pts){{
  var h=_hashPts(pts);
  if(_osrmCache[h])return _osrmCache[h];
  var coords=pts.map(function(p){{return p.lng+','+p.lat;}}).join(';');
  try{{
    var r=await fetch('https://router.project-osrm.org/route/v1/foot/'+coords+'?overview=full&geometries=geojson');
    var d=await r.json();
    if(d.routes&&d.routes[0]){{
      var geo=d.routes[0].geometry.coordinates;
      _osrmCache[h]=geo;_saveCache(_osrmCache);return geo;
    }}
  }}catch(e){{}}
  return null;
}}
async function drawItineraries(forceRecalc){{
  Object.keys(_routeLayers).forEach(function(k){{_routeLayers[k].forEach(function(l){{map.removeLayer(l);}});}});
  _routeLayers={{}};
  if(!ITINERARY||!Object.keys(ITINERARY).length)return;
  if(forceRecalc){{_osrmCache={{}};_saveCache(_osrmCache);}}
  for(var date in ITINERARY){{
    var day=ITINERARY[date];
    _routeLayers[date]=[];
    var capturedDate=date;
    var segments=[];
    var cur=[];
    for(var pi=0;pi<day.pts.length;pi++){{
      var pt=day.pts[pi];
      cur.push(pt);
      if(pt.walk_after===false&&pi<day.pts.length-1){{
        if(cur.length>=2)segments.push(cur);
        cur=[day.pts[pi+1]];pi++;
      }}
    }}
    if(cur.length>=2)segments.push(cur);
    for(var si=0;si<segments.length;si++){{
      var seg=segments[si];
      var geo=await fetchOSRMRoute(seg);
      var line;
      if(geo){{
        var latlngs=geo.map(function(c){{return[c[1],c[0]];}});
        line=L.polyline(latlngs,{{color:day.color,weight:4,opacity:0.8,dashArray:'8,4'}});
      }}else{{
        var latlngs=seg.map(function(p){{return[p.lat,p.lng];}});
        line=L.polyline(latlngs,{{color:day.color,weight:3,opacity:0.5,dashArray:'4,4'}});
      }}
      (function(d){{line.on('click',function(){{_filterDay(d);}});line.addTo(map);_routeLayers[d].push(line);}})( capturedDate);
    }}
    day.pts.forEach(function(p,i){{
      var bk=day.color;
      var num=L.marker([p.lat,p.lng],{{icon:L.divIcon({{
        html:'<div style="position:relative;width:24px;height:24px"><span style="position:absolute;top:-4px;right:-4px;background:'+bk+';color:#fff;border-radius:50%;width:12px;height:12px;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;border:1px solid #fff;line-height:1">'+(i+1)+'</span></div>',
        className:'',iconSize:[24,24],iconAnchor:[12,12]
      }})}}).bindTooltip((i+1)+'. '+(p.nom||''),{{permanent:false}});
      num.addTo(map);_routeLayers[capturedDate].push(num);
    }});
  }}
}}
var _activeDay=null;
function _filterDay(date){{
  if(_activeDay===date){{_activeDay=null;}}
  else{{_activeDay=date;}}
  Object.keys(_routeLayers).forEach(function(d){{
    var show=(_activeDay===null||_activeDay===d);
    _routeLayers[d].forEach(function(l){{if(show)l.addTo(map);else map.removeLayer(l);}});
  }});
}}
drawItineraries(false);
var _rcBtn=document.createElement('button');
_rcBtn.id='btn-recalc';_rcBtn.textContent='🔄 Recalculer';
_rcBtn.style.cssText='position:absolute;top:50px;right:10px;z-index:1000;background:#fff;border:2px solid #ccc;border-radius:6px;padding:5px 9px;cursor:pointer;font-size:.8rem;box-shadow:0 2px 6px rgba(0,0,0,.2)';
_rcBtn.onclick=function(){{drawItineraries(true);}};
document.body.appendChild(_rcBtn);
const statutLbl={{a_reserver:'🔴 À réserver',reserve:'🟡 Réservé',paye:'🟢 Payé'}};
const bounds=[];
let addMode=false, tempMarker=null;

markers.forEach(m=>{{
  const div=document.createElement('div');
  div.style.cssText='font-size:18px;cursor:pointer;filter:drop-shadow(0 2px 3px rgba(0,0,0,.4))';
  div.textContent=m.ico;
  const icon=L.divIcon({{html:div.outerHTML,className:'',iconSize:[24,24],iconAnchor:[12,12]}});
  const mk=L.marker([m.lat,m.lng],{{icon}}).addTo(map);
  const resa=m.resa?'<br><span style="background:#ffe5e7;color:#e63946;font-size:.7rem;padding:1px 5px;border-radius:3px">⚠️ Résa requise</span>':'';
  const st=m.statut?'<br>'+(statutLbl[m.statut]||m.statut):'';
  const lienHtml=m.lien?'<br><a href="'+m.lien+'" target="_blank" style="color:#1565c0;font-size:.75rem">🔗 Réservation</a>':'';
  mk.bindPopup('<b>'+m.nom+'</b><br>📅 '+m.date+' · '+m.moment+'<br>💶 '+m.prix+st+resa
    +'<br><a href="https://www.google.com/maps/search/?q='+m.lat+','+m.lng+'" target="_blank" style="color:#1565c0">📍 Google Maps</a>'
    +lienHtml);
  bounds.push([m.lat,m.lng]);
}});

routes.forEach(r=>{{
  const ll=r.pts.map(p=>[p.lat,p.lng]);
  L.polyline(ll,{{color:r.color,weight:3,opacity:.7,dashArray:'6,4'}}).addTo(map);
  if(r.dist_km){{
    const mid=[(ll[0][0]+ll[1][0])/2,(ll[0][1]+ll[1][1])/2];
    const lbl=r.v1+' → '+r.v2+' ('+r.dist_km+' km)';
    L.marker(mid,{{icon:L.divIcon({{html:'<span style="background:#fff;border:1px solid #ddd;border-radius:4px;padding:1px 5px;font-size:.6rem;white-space:nowrap;color:#4a4a6a">'+lbl+'</span>',className:'',iconSize:[120,18],iconAnchor:[60,9]}})}}).addTo(map);
    bounds.push(mid);
  }}
  ll.forEach(p=>bounds.push(p));
}});
if(bounds.length>0){{try{{map.fitBounds(bounds,{{padding:[30,30]}});}}catch(e){{map.setView([46,10],5);}}}}
else map.setView([46,10],5);

function toggleMode(){{
  addMode=!addMode;
  const btn=document.getElementById('mode-btn');
  btn.classList.toggle('active',addMode);
  map.getContainer().style.cursor=addMode?'crosshair':'';
}}

map.on('click',async function(e){{
  if(!addMode)return;
  const lat=e.latlng.lat.toFixed(6), lng=e.latlng.lng.toFixed(6);
  if(tempMarker)map.removeLayer(tempMarker);
