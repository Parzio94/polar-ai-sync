def deduct_api_cost(input_tokens, output_tokens, model="haiku"):
    """Déduit le coût d'un appel Claude de api_cost.json.
    Haiku 4.5 : $0.80/M input, $4.00/M output
    Sonnet 4  : $3.00/M input, $15.00/M output"""
    cf = POLAR / "api_cost.json"
    try:
        cj = json.loads(cf.read_text()) if cf.exists() else \
             {"budget_initial_usd": 5.85, "restant_usd": 4.74}
        if "sonnet" in model.lower():
            cost = (input_tokens * 3.0 + output_tokens * 15.0) / 1_000_000
        else:  # haiku par défaut
            cost = (input_tokens * 0.8 + output_tokens * 4.0) / 1_000_000
        cj["restant_usd"] = round(cj.get("restant_usd", 4.74) - cost, 6)
        cj.setdefault("total_calls", 0)
        cj["total_calls"] += 1
        cf.write_text(json.dumps(cj, indent=2))
    except: pass

def detect_next_session(date_str):
    """Détecte dynamiquement si le lendemain est une sortie longue
    (duree_min >= 90 ET rpe >= 4) depuis _load_programme().
    Fallback sur load_exercises() si programme absent.
    Retourne {"is_long": bool, "label": str}"""
    try:
        d = datetime.strptime(date_str, "%Y-%m-%d")
        next_d = (d + timedelta(days=1)).strftime("%Y-%m-%d")
        prog = _load_programme()
        for week_key, week_data in prog.items():
            sessions = week_data.get("sessions", []) if isinstance(week_data, dict) else []
            # Support both "sessions" and "seances" key names
            if not sessions:
                sessions = week_data.get("seances", []) if isinstance(week_data, dict) else []
            for session in sessions:
                s_date = str(session.get("date",""))[:10]
                if s_date == next_d:
                    duree = float(session.get("duree_min") or session.get("duration_min") or
                                  session.get("duree","0").replace("min","").replace("h","*60+").strip() if
                                  "h" not in str(session.get("duree","")) else 0 or 0)
                    # Calcul durée depuis format "1h30" ou "90min"
                    duree_raw = str(session.get("duree","") or session.get("duree_min","") or "0")
                    try:
                        if "h" in duree_raw:
                            parts = duree_raw.replace("min","").split("h")
                            duree = int(parts[0])*60 + int(parts[1]) if len(parts)>1 and parts[1] else int(parts[0])*60
                        elif "min" in duree_raw:
                            duree = int(duree_raw.replace("min","").strip())
                        elif session.get("duree_min"):
                            duree = float(session["duree_min"])
                    except: duree = 0
                    rpe = 0
                    try: rpe = float(session.get("rpe") or 0)
                    except: rpe = 0
                    if duree >= 90 and rpe >= 4:
                        return {"is_long": True,
                                "label": session.get("type", session.get("seance","Sortie longue"))}
        # Fallback : exercices Polar réels
        exercises = load_exercises()
        next_exs = [e for e in exercises
                    if (e.get("start-time","") or e.get("start_time","")).startswith(next_d)]
        for e in next_exs:
            dur_s = parse_duration(e.get("duration_s") or e.get("duration",""))
            if dur_s >= 5400:
                return {"is_long": True, "label": "Sortie longue détectée (Polar)"}
    except Exception:
        pass
    return {"is_long": False, "label": ""}

def get_dejeuner_macros(date_str):
    """Calcule les macros du déjeuner fixe selon le jour de la semaine."""
    try:
        dow = datetime.strptime(date_str, "%Y-%m-%d").weekday()
    except:
        dow = 0
    # Base immuable tous les jours : 4 oeufs + fromage chèvre 50g + fraises 150g
    m = {"kcal": 344+130+48, "prot_g": 28+9+1, "carb_g": 0+0+11, "fat_g": 24+10+0}
    if dow in [1, 3, 5]:   # Mar/Jeu/Sam → avocat
        m["kcal"]+=320; m["prot_g"]+=4; m["carb_g"]+=4; m["fat_g"]+=30
    else:                   # Lun/Mer/Ven/Dim → tomate
        m["kcal"]+=36;  m["prot_g"]+=2; m["carb_g"]+=8
    if dow in [1, 3, 5, 6]:  # Mar/Jeu/Sam/Dim → riz/pâtes + saumon
        m["kcal"]+=266+131; m["prot_g"]+=8+15; m["carb_g"]+=55; m["fat_g"]+=1+8
    # Vendredi → pas d'extra (exclu par dow not in [1,3,5,6])
    return m

def generate_dinner_options(date_str):
    """Génère 2-3 options dîner depuis le frigo disponible."""
    import itertools
    fridge    = load_nutrition_fridge()
    foods     = load_nutrition_foods()
    foods_map = {f["id"]: f for f in foods}
    next_sess  = detect_next_session(date_str)
    carb_boost = next_sess["is_long"]
    fec_g      = 350 if carb_boost else 250

    def make_item(food_id, qty_g):
        f = foods_map.get(food_id)
        if not f: return None
        r = qty_g / f["portion_g"]
        return {"food_id": food_id, "food_name": f["name"], "qty_g": qty_g,
                **{k: round(f[k]*r, 1) for k in ["kcal","prot_g","carb_g","fat_g"]}}

    fixed_defs = [("pain",100),("banane",120),("chocolat_noir",30),("skyr",100),("miel",15)]
    fixed_items = [it for it in (make_item(fid,qty) for fid,qty in fixed_defs) if it]

    viande_ids = ["poulet_filet","boeuf","porc","rumsteak","porc_echine","lardons","dinde"]
    viandes = [s for s in fridge if s["food_id"] in viande_ids and s["stock_g"] >= 200]
    if not viandes:
        viandes = [s for s in fridge
                   if s["food_id"] not in ["pates_cuites","riz_cuit","grenailles","pain",
                                            "banane","chocolat_noir","skyr","miel"]
                   and s["stock_g"] >= 150][:1]

    feculent_ids = ["pates_cuites","riz_cuit","grenailles"]
    feculents = [s for s in fridge if s["food_id"] in feculent_ids and s["stock_g"] >= fec_g]
    if not feculents:
        feculents = [s for s in fridge if s["food_id"] in feculent_ids and s["stock_g"] >= 100][:1]

    sauces = [f for f in foods if f.get("condiment") and
              f["id"] in ["sauce_soja","moutarde_miel","sauce_tomate","creme_fraiche"]]

    if not viandes or not feculents:
        return []

    combos = list(itertools.product(viandes[:2], feculents[:2], sauces[:2]))[:3]
    options = []
    for v_s, fe_s, sauce in combos:
        v_item  = make_item(v_s["food_id"], 200)
        fe_item = make_item(fe_s["food_id"], fec_g)
        s_item  = make_item(sauce["id"], 30)
        if not v_item or not fe_item or not s_item: continue
        items = fixed_items + [v_item, fe_item, s_item]
        total = {k: round(sum(i[k] for i in items), 1)
                 for k in ["kcal","prot_g","carb_g","fat_g"]}
        options.append({
            "label": f"{v_item['food_name']} + {fe_item['food_name']} + {sauce['name']}",
            "carb_boost": carb_boost,
            "next_session_label": next_sess["label"],
            "items": items, **total
        })
    return options

def calc_bmr(config):
    if config.get("bmr_override"):
        return config["bmr_override"]
    p, t, a = config["poids_kg"], config["taille_cm"], config["age_ans"]
    if config.get("sexe","M") == "M":
        return 10*p + 6.25*t - 5*a + 5
    return 10*p + 6.25*t - 5*a - 161

