                f'<div style="display:flex;align-items:center;gap:4px;margin-top:1px">'
                f'<span style="font-size:.52rem;font-weight:700;color:#fff;opacity:.9;white-space:nowrap">{r["label"]}</span>'
                f'<span style="font-size:.42rem;color:rgba(255,255,255,.35)">—</span>'
                f'<span style="font-size:.44rem;color:rgba(255,255,255,.55)">{date_long}</span>'
                f'</div>'
                f'<div style="font-size:.43rem;font-weight:800;color:#fff;background:{color};padding:1px 5px;border-radius:4px;margin-top:2px;white-space:nowrap">Sub {obj}</div>'
                f'</div>'
