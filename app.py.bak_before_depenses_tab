          '<span style="color:#2d6a4f">C' + Math.round((item.carb_pg||0)*g*10)/10 + '</span> ' +
          '<span style="color:#e63946">L' + Math.round((item.fat_pg||0)*g*10)/10 + '</span>';
        recompute();
      }}
      inp.addEventListener('input', updateFixed);
      updateFixed();
    }});
  }}

  window.onDropChange = function(cat, sel) {{
    const macDiv = document.getElementById('mac-' + cat);
    const idx = sel.selectedIndex;
    if (idx === 0) {{ if (macDiv) macDiv.innerHTML = ''; recompute(); return; }}
    const opt = sel.options[idx];
    try {{
      const item = JSON.parse(opt.dataset.item.replace(/&quot;/g, '"'));
      if (macDiv) macDiv.innerHTML =
        '<span style="background:#fff3e0;color:#b45309;padding:1px 4px;border-radius:3px;font-weight:700">' + Math.round((item.kcal_pg||0)*item.qty_g) + 'kcal</span> ' +
        '<span style="color:#006d77;font-weight:700">P' + Math.round((item.prot_pg||0)*item.qty_g*10)/10 + 'g</span> ' +
        '<span style="color:#2d6a4f;font-weight:700">C' + Math.round((item.carb_pg||0)*item.qty_g*10)/10 + 'g</span> ' +
        '<span style="color:#e63946;font-weight:700">L' + Math.round((item.fat_pg||0)*item.qty_g*10)/10 + 'g</span> ' +
        '<span style="color:#9ca3af;font-size:.58rem">' + item.qty_g + 'g</span>';
    }} catch(e) {{}}
    recompute();
  }};

  function getDropItem(cat) {{
    const sel = document.getElementById('drop-' + cat);
    if (!sel || sel.selectedIndex <= 0) return null;
    try {{ return JSON.parse(sel.options[sel.selectedIndex].dataset.item.replace(/&quot;/g, '"')); }}
    catch(e) {{ return null; }}
  }}

  function recompute() {{
    let kcal=0, prot=0, carb=0, fat=0;
    D.fixed_items.forEach(item => {{
      const inp = document.getElementById('finp-' + item.food_id);
      const g = parseFloat(inp ? inp.value : item.qty_g) || 0;
      kcal += (item.kcal_pg||0)*g; prot += (item.prot_pg||0)*g;
      carb += (item.carb_pg||0)*g; fat  += (item.fat_pg ||0)*g;
    }});
    ['viande','feculent','legume','sauce'].forEach(cat => {{
      const item = getDropItem(cat);
      if (!item) return;
      const g = item.qty_g || 0;
      kcal += (item.kcal_pg||0)*g; prot += (item.prot_pg||0)*g;
      carb += (item.carb_pg||0)*g; fat  += (item.fat_pg ||0)*g;
    }});
    kcal = Math.round(kcal); prot = Math.round(prot*10)/10;
    carb = Math.round(carb*10)/10; fat = Math.round(fat*10)/10;
    const $= id => document.getElementById(id);
    if ($('lt-kcal')) $('lt-kcal').textContent = kcal + ' kcal';
    if ($('lt-prot')) $('lt-prot').textContent = 'P ' + prot + 'g';
    if ($('lt-carb')) $('lt-carb').textContent = 'C ' + carb + 'g';
    if ($('lt-fat'))  $('lt-fat').textContent  = 'L ' + fat + 'g';
    const btn = $('btn-confirm-meal');
    const ready = getDropItem('viande') && getDropItem('feculent') && getDropItem('sauce');
    if (btn) {{
      btn.disabled = !ready;
      btn.style.background = ready ? '#2d6a4f' : '#d1d5db';
      btn.style.cursor = ready ? 'pointer' : 'not-allowed';
    }}
  }}

  // Auto-select first option in each required dropdown
  ['viande','feculent','sauce'].forEach(cat => {{
    const sel = document.getElementById('drop-' + cat);
    if (sel && sel.options.length > 1) {{
      sel.selectedIndex = 1;
      window.onDropChange(cat, sel);
    }}
  }});
}})();

