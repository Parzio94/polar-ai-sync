async function stepStock(foodId, unitG, delta) {{
  const portEl = document.getElementById('port-' + foodId);
  const gEl    = document.getElementById('gstock-' + foodId);
  if (!portEl) return;
  let portions = parseInt(portEl.textContent) || 0;
  portions = Math.max(0, portions + delta);
  const newG = portions * unitG;
  portEl.textContent = portions;
  if (gEl) gEl.textContent = newG + 'g';
  portEl.style.color = '#2d6a4f';
  setTimeout(() => {{ portEl.style.color = ''; }}, 600);
  await fetch('/api/nutrition/fridge/update', {{
    method:'POST', headers:{{'Content-Type':'application/json'}},
    body: JSON.stringify({{food_id: foodId, stock_g: newG}})
  }});
}}

