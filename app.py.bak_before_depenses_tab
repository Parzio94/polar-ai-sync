def _build_voyages_page(voyage_id=None):
    voyages_data = load_voyages()
    voyages = voyages_data.get("voyages",[])
    today   = now_local().strftime("%Y-%m-%d")

    liste_html = ""
    # ── Bouton nouveau voyage EN HAUT ─────────────────────────
    liste_html += '<button class="btn-sm bw" onclick="voyOpenCreate()" style="width:100%;justify-content:center;margin-bottom:4px"><span class="bi">✈️</span><div><span class="bl">+ Nouveau voyage</span></div></button>'

    cards_actifs = []
    cards_passes = []

    for v in sorted(voyages, key=lambda x: x.get("date_debut","")):
        vid  = v["id"]
        bmin, bmax = budget_estime_voyage(v)
        breel      = budget_reel_voyage(v)
        avg        = (bmin+bmax)/2 if bmin+bmax else 0
        pct_reel   = round(breel/avg*100) if avg else 0
        sts  = _voyage_statuts_count(v)
        col  = v.get("couleur","#52b788")
        ico  = {"avion":"✈️","velo":"🚴","road_trip":"🚗","train":"🚂"}.get(v.get("type",""),"🌍")
        try:
            dt_deb    = datetime.strptime(v["date_debut"],"%Y-%m-%d")
            dt_fin    = datetime.strptime(v["date_fin"],"%Y-%m-%d")
            today_dt  = datetime.strptime(today,"%Y-%m-%d").date()
            days      = (dt_deb.date() - today_dt).days
            if today_dt > dt_fin.date():
                countdown = "Passé"
            elif today_dt >= dt_deb.date():
                countdown = "En cours 🚀"
            else:
                countdown = f"J-{days}"
        except Exception as e:
            logging.warning("Erreur calcul countdown voyage %s: %s", v.get("id","?"), e)
            countdown = ""
        # Voyage passé = date_fin strictement avant aujourd'hui
        try:
            is_past = datetime.strptime(v["date_fin"],"%Y-%m-%d").date() < datetime.strptime(today,"%Y-%m-%d").date()
        except: is_past = False
        statuts_html = ""
        if sts["a_reserver"]: statuts_html += f'<span class="voy-s-a">🔴 {sts["a_reserver"]} à réserver</span>'
        if sts["paye"]:       statuts_html += f'<span class="voy-s-p">🟢 {sts["paye"]} payé</span>'
        prix_str  = f"{int(breel)} € réel" if breel else "Budget non défini"
        is_active = vid == voyage_id
        card = (f'<div class="voy-card" id="card-{vid}" style="{"border:2px solid "+col if is_active else ""}">'
                f'<div class="voy-card-banner" style="background:{col}"></div>'
                f'<div class="voy-card-head">'
                f'<div><div class="voy-card-title">{ico} {v["nom"]}</div>'
                f'<div class="voy-card-dates">{_fmt_date_short(v["date_debut"])} → {_fmt_date_short(v["date_fin"])} {v["date_fin"][:4]}</div></div>'
                f'<div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">'
                f'<div class="voy-card-countdown" style="color:{col if not is_past else "#9ca3af"}">{countdown}</div>'
                f'<button onclick="voyOpenEditVoyage(\'{vid}\',\'{v["nom"].replace(chr(39), chr(8217))}\',\'{v["date_debut"]}\',\'{v["date_fin"]}\',\'{v.get("type","avion")}\',\'{col}\')" '
                f'style="font-size:.6rem;font-weight:700;color:{col};background:transparent;border:1px solid {col};border-radius:6px;padding:2px 7px;cursor:pointer;white-space:nowrap">✏️ Modifier</button>'
                f'</div></div>'
                f'<div class="voy-card-body">'
                f'<div class="voy-budget-bar"><div class="voy-budget-fill" style="width:{min(100,pct_reel)}%;background:{col}"></div></div>'
                f'<div style="font-size:.72rem;font-weight:700;color:#1a1a2e">{prix_str}</div>'
                f'<div class="voy-statuts">{statuts_html}</div>'
                f'<div style="display:flex;gap:6px;margin-top:8px">'
                f'<button class="voy-toggle-btn" style="flex:1" onclick="location.href=\'/voyages?id={vid}\'">📋 Détail</button>'
                f'<button class="voy-toggle-btn" onclick="voyMapFocus(\'{vid}\')" style="flex:0 0 auto;padding:7px 10px">🗺️</button>'
                f'<button class="voy-toggle-btn" onclick="voyConfirmDelete(\'{vid}\')" style="flex:0 0 auto;padding:7px 10px;color:#e63946">🗑️</button>'
                f'</div></div></div>')
        if is_past:
            cards_passes.append(card)
        else:
            cards_actifs.append(card)

    # Voyages actifs/futurs (ordre chronologique, déjà trié)
    liste_html += "".join(cards_actifs)

    # ── Section repliable voyages passés ──────────────────────
    if cards_passes:
        nb = len(cards_passes)
        auto_open = "open" if (voyage_id and any(('id="card-'+voyage_id+'"') in c for c in cards_passes)) else ""
        nb_label = f'{nb} voyage{"s" if nb>1 else ""} pass\u00e9{"s" if nb>1 else ""}'
        liste_html += (
            f'<details style="margin-top:6px" {auto_open}>'
            f'<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:6px;'
            f'padding:7px 10px;background:#f7f5f0;border:1px solid #e8e4dc;border-radius:9px;'
            f'font-size:.72rem;font-weight:700;color:#6b7280;user-select:none">'
            f'<span style="font-size:.7rem">▸</span> {nb_label}'
            f'</summary>'
            f'<div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;opacity:.85">'
            + "".join(cards_passes) +
            f'</div></details>'
        )

    detail_html = ""
    if voyage_id:
        voyage = next((v for v in voyages if v["id"] == voyage_id), None)
        if voyage:
            # Injecter tous les éléments du voyage en JS pour l'édition
            els_map = {e["id"]: e for e in voyage.get("elements", [])}
            detail_html += f'<script>var _VOY_ELEMENTS={json.dumps(els_map, ensure_ascii=False)};var _CURRENT_VOYAGE_ID="{voyage_id}";</script>'
            detail_html += (
                f'<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'
                f'<button onclick="history.back()" style="background:#f7f5f0;border:1px solid #e8e4dc;border-radius:8px;'
                f'padding:5px 12px;font-size:.72rem;font-weight:700;color:#1a1a2e;cursor:pointer">← Retour</button>'
                f'<a href="/api/voyages/{voyage_id}/export_pdf" target="_blank" '
                f'style="background:#1a1a2e;border:none;border-radius:8px;'
                f'padding:5px 12px;font-size:.72rem;font-weight:700;color:#fff;text-decoration:none">📄 Exporter PDF</a>'
                f'</div>'
            )
            detail_html += (f'<div class="voy-toggle">'
                            f'<button class="voy-toggle-btn active" id="btn-vue-jour" onclick="voyVue(\'jour\')">📅 Par jour</button>'
                            f'<button class="voy-toggle-btn" id="btn-vue-cat" onclick="voyVue(\'cat\')">📋 Par catégorie</button>'
                            f'</div>')
            # Étapes
            etapes_html = ""
            for e in voyage.get("etapes",[]):
                etapes_html += (f'<div style="display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid #e8e4dc">'
                                f'<span style="font-weight:700;font-size:.78rem">📍 {e["nom"]}</span>'
                                f'<span style="font-size:.65rem;color:#4a4a6a">{_fmt_date_short(e["date_debut"])} → {_fmt_date_short(e["date_fin"])}</span>'
