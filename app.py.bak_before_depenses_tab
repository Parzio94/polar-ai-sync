def get_lunch_prefill(date_str, fridge, foods):
    """
    Calcule le pré-remplissage du déjeuner depuis le frigo et les foods.
    Retourne { label, items[], kcal, prot_g, carb_g, fat_g } ou None.
    """
    foods_map = {f["id"]: f for f in foods}
    fridge_map = {s["food_id"]: s for s in fridge}
    try:
        dow = datetime.strptime(date_str, "%Y-%m-%d").weekday()
    except Exception:
        dow = 0

    # Protocole course : bloquer certains aliments
    proto = get_race_protocol(date_str)
    blocked = set(proto["blocked_ids"]) if proto else set()

    items = []

    def add_item(food_id, qty_g):
        if food_id in blocked: return
        fm = foods_map.get(food_id)
        if not fm or not fm.get("portion_g"): return
        r = qty_g / fm["portion_g"]
        items.append({
            "food_id":   food_id,
            "food_name": fm["name"],
            "qty_g":     qty_g,
            "kcal":   round(fm["kcal"]   * r, 1),
            "prot_g": round(fm["prot_g"] * r, 1),
            "carb_g": round(fm["carb_g"] * r, 1),
            "fat_g":  round(fm["fat_g"]  * r, 1),
        })

    # ── Œufs : toujours 4
    add_item("oeuf", 240)  # 4 × 60g

    # ── Fromage : priorité camembert > brie > fromage_chevre > comte > emmental > mozzarella
    cheese_priority = ["camembert","brie","fromage_chevre","comte","emmental","mozzarella"]
    for cid in cheese_priority:
        if cid in blocked: continue
        stk = fridge_map.get(cid, {}).get("stock_g", 0)
        if stk >= 40:
            add_item(cid, 50)
            break

    # ── Fraises : toujours 150g si dispo
    if fridge_map.get("fraises", {}).get("stock_g", 0) >= 100:
        add_item("fraises", 150)

    # ── Avocat : Mar/Jeu/Sam (weekday 1, 3, 5) si stock > 0
    if dow in [1, 3, 5]:
        if fridge_map.get("avocat", {}).get("stock_g", 0) >= 100:
            add_item("avocat", 160)
    else:
        # Sinon tomate 100g si dispo
        if fridge_map.get("tomate", {}).get("stock_g", 0) >= 80:
            add_item("tomate", 100)

    # ── J-1/J-2 : remplacer fromage gras par banane si dispo
    if proto and proto["days_left"] <= 2:
        items = [it for it in items if it["food_id"] not in ["camembert","brie","comte","emmental","fromage_chevre"]]
        if fridge_map.get("banane", {}).get("stock_g", 0) >= 120:
            add_item("banane", 120)

    if not items:
        return None

    tot = {k: round(sum(it[k] for it in items), 1) for k in ["kcal","prot_g","carb_g","fat_g"]}
    label = " + ".join(it["food_name"] for it in items)
    return {"label": label, "items": items, **tot}


