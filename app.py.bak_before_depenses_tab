@app.route("/api/fetch_splits", methods=["POST"])
def api_fetch_splits():
    """Fetche et calcule les splits km d'un exercice depuis l'API Polar."""
    data = request.get_json()
    exercise_id = (data or {}).get("exercise_id", "")
    force = (data or {}).get("force", False)
    if not exercise_id:
        return jsonify({"ok": False, "error": "exercise_id manquant"})
    cached = load_splits(exercise_id)
    # Retourner le cache seulement s'il est complet (a samples_5s) et pas de force
    if cached and cached.get("samples_5s") and not force:
        return jsonify({"ok": True, "cached": True, **cached})
    try:
        result = fetch_splits_from_api(exercise_id)
        if not result or not result.get("splits"):
            return jsonify({"ok": False, "error": "Pas de samples disponibles"})
        # Conserver les splits km existants si le nouveau résultat en manque
        if cached and not result.get("splits") and cached.get("splits"):
            result["splits"] = cached["splits"]
        save_splits(exercise_id, result)
        return jsonify({"ok": True, "cached": False, **result})
    except Exception as e:
        # Si erreur API mais cache existant, retourner le cache
        if cached:
            return jsonify({"ok": True, "cached": True, "api_error": str(e), **cached})
        return jsonify({"ok": False, "error": str(e)})

