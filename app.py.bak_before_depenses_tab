    # ── Boucle jours ──────────────────────────────────────────────
    i = 0
    while i < len(all_dates):
        date_str = all_dates[i]
        moments  = elements_du_jour(voyage, date_str)
        has_content = any(moments[m] for m in moments)
        jour_num = i + 1

        if not has_content:
            # Grouper jours vides consécutifs
            j = i
            while j < len(all_dates):
                m2 = elements_du_jour(voyage, all_dates[j])
                if any(m2[m] for m in m2): break
                j += 1
            if j - i == 1:
                lbl = f"Jour {jour_num}  —  {fmt_day(date_str)}"
            else:
                lbl = f"Jours {jour_num}-{i+j-i}  —  {fmt_day(date_str)} - {fmt_day(all_dates[j-1])}"

            # Bloc fond gris clair
            inner = Table([[Paragraph(lbl, c_day)],
                           [Paragraph("Libre", c_free_lbl)]],
                          colWidths=[PAGE_W - 2*MARGIN - 0.2*cm])
            inner.setStyle(TableStyle([
                ("BACKGROUND",   (0,0),(-1,-1), COL_FREE),
                ("LEFTPADDING",  (0,0),(-1,-1), 8),
                ("TOPPADDING",   (0,0),(-1,-1), 4),
                ("BOTTOMPADDING",(0,0),(-1,-1), 4),
                ("BOX",          (0,0),(-1,-1), 0.5, COL_LINE),
            ]))
            story.append(inner)
            story.append(Spacer(1, 6))
            i = j
            continue

        # Jour avec contenu
        db = day_budget(voyage, date_str)
        day_block = []
        day_block.append(Paragraph(f"Jour {jour_num}  —  {fmt_day(date_str)}", c_day))
        if db > 0:
            day_block.append(Paragraph(f"Depenses du jour : {db:.0f} EUR", c_daybudg))
        etape = etape_du_jour(voyage, date_str)
        if etape: day_block.append(Paragraph(_safe(etape["nom"]), c_city))

        for moment_key in ["matin","midi","aprem","soir"]:
            els = moments[moment_key]
            if not els: continue
            day_block.append(Paragraph(MOMENT_LBL[moment_key], c_moment))
            for el in els:
                render_el(el, day_block)

        day_block.append(HRFlowable(width="100%", thickness=0.5, color=COL_LINE, spaceAfter=4))
        story.append(KeepTogether(day_block))
        i += 1

    # ════════════════════════════════════════════════════════════════
    # DERNIERE PAGE : Récapitulatif réservations
    # ════════════════════════════════════════════════════════════════
    if reservations:
        story.append(PageBreak())
        story.append(Paragraph("Recapitulatif des reservations", c_sec))
        story.append(HRFlowable(width="100%", thickness=1, color=COL_DARK, spaceAfter=10))

        for r in reservations:
            nom_r   = _safe(r["nom"])
            date_r  = r["date"]
            confirm = r["confirmation"]
            lien_r  = r["lien"]
            statut  = r["statut"]
            type_r  = TYPE_LBL.get(r["type"],"")

            parts = [f"<b>{_safe(type_r)}</b>  {nom_r}"]
            if date_r: parts.append(f"<font color='#6b7280'>{date_r}</font>")
            if statut: parts.append(f"<font color='#6b7280'>({statut})</font>")
            story.append(Paragraph("  ".join(parts), c_recap_el))
            if confirm:
                story.append(Paragraph(f"Ref : <b>{confirm}</b>", c_detail))
            if lien_r:
                story.append(Paragraph(f'<link href="{lien_r}">Voir la reservation</link>', c_maps))
            story.append(Spacer(1, 3))

    doc.build(story)
    buf.seek(0)
    nom_fichier = nom.replace(" ","_").replace("/","_")[:40]
    from flask import send_file
    return send_file(buf, mimetype="application/pdf",
                     as_attachment=True,
                     download_name=f"voyage_{nom_fichier}.pdf")



