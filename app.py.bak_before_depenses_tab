    today = now_local().strftime("%Y-%m-%d")
    fridge = []
    for it in d.get("items", []):
        if it.get("food_id") in condiment_ids: continue
        try: stock = max(0, float(it.get("stock_g", 0)))
        except: stock = 0
        if stock > 0:
            entry = {"food_id": it["food_id"], "food_name": it["food_name"],
                     "stock_g": stock, "added_date": today}
            # Conserver qty_count (nb pièces) si fourni
            if it.get("qty_count") is not None:
                try: entry["qty_count"] = int(it["qty_count"])
                except: pass
            fridge.append(entry)
