@app.route("/api/upload-programme", methods=["POST"])
def api_upload_programme():
    """Reçoit un .xlsx, génère les semaine_*.json et recharge PROGRAMME en mémoire."""
    try:
        if "file" not in request.files:
            return jsonify({"ok": False, "error": "Aucun fichier reçu"})
        f = request.files["file"]
        if not f.filename or not f.filename.lower().endswith(".xlsx"):
            return jsonify({"ok": False, "error": "Fichier .xlsx requis"})

        # Sauvegarder dans un fichier temporaire d'abord
        tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".xlsx")
        f.save(tmp.name)
        tmp.close()

        # Installer openpyxl si absent
        try:
            import openpyxl as _xl
        except ImportError:
            subprocess.run([sys.executable, "-m", "pip", "install", "openpyxl",
                            "--break-system-packages", "-q"], check=True)
            import openpyxl as _xl

        SPORT_MAP = {
            "Course":"Course","Natation":"Natation",
            "Vélo":"Velo","Velo":"Velo","Ski":"Ski","Renfo":"Renfo"
        }

        def _fmt_duree(val):
            if val is None: return "—"
            try:
                mins = int(float(str(val)))
                if mins >= 60:
                    h, m = divmod(mins, 60)
                    return f"{h}h{m:02d}" if m else f"{h}h"
                return f"{mins}min"
            except Exception:
                return str(val)

        wb = _xl.load_workbook(tmp.name, data_only=True)
        ws = wb.active
        semaines = {}
        current_sem = None

        for row in ws.iter_rows(values_only=True):
            if not any(c is not None for c in row):
                continue
            cols = (list(row) + [None] * 12)[:11]
            date_val, jour, discipline, seance, duree, zones, rpe, structure, dist_course_km, dist_velo_km, dist_nat_m = cols

            # Ligne titre "Semaine N"
            num_sem = None
            if isinstance(date_val, str):
                _m = re.match(r'^\s*(?:Semaine\s+(\d+)|S0?(\d+)\b)', date_val.strip(), re.IGNORECASE)
                if _m:
                    num_sem = int(_m.group(1) or _m.group(2))
            if num_sem is not None:
                current_sem = f"Semaine {num_sem}"
                if current_sem not in semaines:
                    semaines[current_sem] = {"num": num_sem, "seances": []}
                continue

            # Ligne séance valide (date est un datetime)
            if hasattr(date_val, "strftime") and discipline:
                if current_sem is None:
                    current_sem = "Semaine 1"
                    semaines[current_sem] = {"num": 1, "seances": []}

                sport = SPORT_MAP.get(str(discipline).strip(), str(discipline).strip())

                try:    dist_cible   = float(dist_course_km) if dist_course_km is not None else None
                except: dist_cible   = None
                try:    dist_velo    = float(dist_velo_km)   if dist_velo_km   is not None else None
                except: dist_velo    = None
                try:    dist_cible_m = int(dist_nat_m)        if dist_nat_m     is not None else None
                except: dist_cible_m = None

                # Vélo : utiliser la colonne dédiée
                if sport == "Velo":
                    dist_cible   = dist_velo
                    dist_cible_m = None

                obj = {
                    "date":      date_val.strftime("%Y-%m-%d"),
                    "jour":      str(jour).strip() if jour else "",
                    "sport":     sport,
                    "type":      str(seance).strip() if seance else "",
                    "duree":     _fmt_duree(duree),
                    "zone":      str(zones).strip() if zones else "",
                    "rpe":       str(rpe).strip() if rpe else "",
                    "structure": str(structure).strip() if structure else "",
                }
                if dist_cible   is not None: obj["dist_cible"]   = dist_cible
                if dist_cible_m is not None: obj["dist_cible_m"] = dist_cible_m
                semaines[current_sem]["seances"].append(obj)

        # Copier le fichier Excel dans /root/polar/ pour référence future
        import shutil as _sh
        _sh.copy2(tmp.name, str(POLAR / "Marathon_programme.xlsx"))

        # Supprimer le fichier temporaire
        try: os.unlink(tmp.name)
        except: pass

        # Écriture des JSON
        prog_dir = POLAR / "programme"
        prog_dir.mkdir(parents=True, exist_ok=True)
        # Supprimer UNIQUEMENT les semaines présentes dans le nouvel Excel
        nums_to_write = set()
        for sem_name, sem_data in semaines.items():
            if sem_data.get("seances"):
                try: nums_to_write.add(int(sem_name.split()[-1]))
                except: pass
        for old_f in prog_dir.glob("semaine_*.json"):
            try:
                num = int(old_f.stem.split("_")[1])
                if num in nums_to_write:
                    old_f.unlink()
            except: pass

        lines_out = []
        written = 0
        for sem_name, sem_data in sorted(semaines.items(), key=lambda x: x[1]["num"]):
            if not sem_data["seances"]: continue
            num = sem_data.get("num","")
            (prog_dir / f"semaine_{num:02d}.json").write_text(
                json.dumps({"semaine": sem_name, "seances": sem_data["seances"]},
                           ensure_ascii=False, indent=2),
                encoding="utf-8"
            )
            nb = len(sem_data["seances"])
            dates = [s["date"] for s in sem_data["seances"]]
            lines_out.append(f"semaine_{num:02d}.json — {nb} séance(s) [{dates[0]} → {dates[-1]}]")
            written += 1

        # Recharger PROGRAMME en mémoire sans restart
        global PROGRAMME
        PROGRAMME = _load_programme()

        total_seances = sum(len(v["seances"]) for v in semaines.values())
        detail = f"{written} semaine(s) · {total_seances} séance(s) importées\n" + "\n".join(lines_out)
        return jsonify({"ok": True, "detail": detail})

    except Exception as e:
        import traceback
        return jsonify({"ok": False, "error": str(e), "trace": traceback.format_exc()})


