s2[idx]);\n    tipEl.style.display="block";\n    var txPx=(mx/scale)+8;if(txPx+100>rect.width)txPx=(mx/scale)-108;\n    tipEl.style.left=txPx+"px";tipEl.style.top=(PT+4)+"px";\n  });\n  svgEl.addEventListener("mouseleave",function(){tipEl.style.display="none";lineEl.setAttribute("x1","-10");});\n}'

@app.route("/api/habits/toggle", methods=["POST"])
def api_habits_toggle():
    b = request.get_json() or {}
    date_str = b.get("date","")
    task     = b.get("task","")
    val      = b.get("val","")
    if not date_str or not task or val not in ("Fait","Non fait"):
        return jsonify({"ok":False,"error":"Paramètres invalides"})
    data = load_habits_log()
    if "log" not in data: data["log"] = {}
    if date_str not in data["log"]: data["log"][date_str] = {}
    data["log"][date_str][task] = val
    save_habits_log(data)
    return jsonify({"ok":True})

@app.route("/habitudes")
def habitudes():
    from datetime import datetime as _dt, timedelta as _td
    data    = load_habits_log()
    log     = data.get("log", {})
    today   = now_local().strftime("%Y-%m-%d")

    # Mois en cours complet (du 1er jour jusqu'à aujourd'hui), récent à gauche
    cur_month = now_local().strftime("%Y-%m")
    first_day = now_local().replace(day=1)
    days_14 = list(reversed([(first_day + _td(days=i)).strftime("%Y-%m-%d")
               for i in range((now_local() - first_day).days + 1)]))
    days_14_asc = days_14
    all_days_sorted = sorted(log.keys(), reverse=True)

    # Navigation par mois
    from collections import defaultdict as _dd
    from flask import request as _req2
    sel_month = _req2.args.get("month", "")
    months = _dd(list)
    for d in all_days_sorted:
        months[d[:7]].append(d)
    month_labels = {"01":"Jan","02":"Fév","03":"Mar","04":"Avr","05":"Mai","06":"Jun",
                    "07":"Jul","08":"Aoû","09":"Sep","10":"Oct","11":"Nov","12":"Déc"}
    month_tabs = ""
    for ym in sorted(months.keys(), reverse=True):
        y, m = ym.split("-")
        lbl = month_labels.get(m, m) + " " + y
        active = "background:#1a1a2e;color:#fff;" if ym == sel_month else "background:#f7f5f0;color:#1a1a2e;"
        month_tabs += (f'<a href="/habitudes?month={ym}" '
                      f'style="padding:4px 10px;border-radius:6px;font-size:.68rem;font-weight:700;'
                      f'text-decoration:none;{active}border:1px solid #e8e4dc">{lbl}</a>')

    # Tableau du mois sélectionné
    if sel_month and sel_month in months:
        month_days = sorted(months[sel_month])
        th_month = "".join(
            f'<th style="padding:3px 5px;text-align:center;font-size:.55rem;font-weight:700;color:#4a4a6a;white-space:nowrap">'
            f'{_dt.strptime(d, "%Y-%m-%d").strftime("%a %d").capitalize()}</th>'
            for d in month_days
        )
        hist_body = ""
        for sec in HABITS_SECTIONS:
            hist_body += (f'<tr style="background:#f7f5f0"><td colspan="{len(month_days)+1}" '
                         f'style="padding:4px 8px;font-size:.6rem;font-weight:800;color:#9ca3af;text-transform:uppercase">'
                         f'{sec["name"]}</td></tr>')
            for task in sec["tasks"]:
                row = f'<tr style="border-bottom:1px solid #f5f2ee"><td style="padding:4px 8px;font-size:.68rem;font-weight:600;color:#1a1a2e;white-space:nowrap">{task}</td>'
                for d in month_days:
                    v = log.get(d, {}).get(task, "")
                    bg = "#2d6a4f" if v=="Fait" else "#e63946" if v=="Non fait" else "#e8e4dc"
                    txt = "✓" if v=="Fait" else "✗" if v=="Non fait" else "·"
                    tcol = "#fff" if v else "#bbb"
                    te = task.replace('"', '&quot;')
                    row += (f'<td style="text-align:center;padding:2px 3px">'
                           f'<span style="display:inline-block;width:22px;height:22px;border-radius:4px;'
                           f'background:{bg};font-size:.65rem;color:{tcol};line-height:22px;text-align:center;cursor:pointer"'
                           f' onclick="habitEdit(this,&quot;{te}&quot;,&quot;{d}&quot;,&quot;{v}&quot;)">{txt}</span></td>')
                row += "</tr>"
                hist_body += row
        hist_month_html = (
            f'<div id="hab-hist" style="overflow-x:auto;padding:0 0 8px 0">'
            f'<table style="border-collapse:collapse;font-size:.65rem;white-space:nowrap">'
            f'<thead><tr>'
            f'<th style="padding:4px 8px;text-align:left;font-size:.6rem;color:#4a4a6a;min-width:140px">Habitude</th>'
            f'{th_month}</tr></thead><tbody>{hist_body}</tbody></table></div>'
        )
    else:
        hist_month_html = f'<div style="padding:16px;text-align:center;font-size:.72rem;color:#9ca3af">Sélectionne un mois ci-dessus</div>'

    # Streaks par tâche (sur tout l'historique)
    streak_html = ""
    for task in HABITS_ALL_TASKS:
