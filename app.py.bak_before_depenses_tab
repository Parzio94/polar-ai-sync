        else:
            carb_g = round(kcal * 0.55 / 4)
            fat_g  = round(kcal * 0.40 / 9)
            source_reelle = False
        prot_g = round(kcal * 0.05 / 4)
        total_kcal += kcal; total_carb += carb_g; total_fat += fat_g; total_prot += prot_g
        sport = ex.get("sport","")
        seances.append({
            "label": sport, "icon": get_sport_icon(sport),
            "duree": fmt_hm(dur_s), "kcal": kcal,
            "carb_g": carb_g, "fat_g": fat_g, "prot_g": prot_g,
            "source_reelle": source_reelle,
        })
    return {"seances": seances, "kcal_total": total_kcal,
            "carb_g": total_carb, "fat_g": total_fat, "prot_g": total_prot}

