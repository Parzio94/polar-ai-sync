    +'<option value="transport">✈️ Transport</option>'
    +'</select>'
    +'<input id="pm-nom" value="'+nomLieu+'" placeholder="Nom" style="width:100%;padding:5px;border:1px solid #ddd;border-radius:6px;box-sizing:border-box;margin-bottom:5px">'
    +'<input id="pm-date" type="date" style="width:100%;padding:5px;border:1px solid #ddd;border-radius:6px;box-sizing:border-box;margin-bottom:5px">'
    +'<select id="pm-moment" style="width:100%;padding:4px;border-radius:6px;border:1px solid #ddd;margin-bottom:8px">'
    +'<option value="matin">🌅 Matin</option><option value="midi">☀️ Midi</option>'
    +'<option value="aprem">🌤️ Après-midi</option><option value="soir">🌙 Soir</option>'
    +'</select>'
    +'<div style="display:flex;gap:6px">'
    +'<button onclick="pmConfirm('+lat+','+lng+')" style="flex:1;background:#1a1a2e;color:#fff;border:none;border-radius:8px;padding:7px;cursor:pointer;font-size:.78rem">✅ Confirmer</button>'
    +'<button onclick="pmCancel()" style="flex:1;background:#f0f0f0;border:none;border-radius:8px;padding:7px;cursor:pointer;font-size:.78rem">❌ Annuler</button>'
    +'</div></div>'
  ).openOn(map);
}});

async function pmConfirm(lat,lng){{
  if(!VOYAGE_ID){{alert('Aucun voyage sélectionné — ouvrez la carte depuis un voyage.');return;}}
  const type=document.getElementById('pm-type').value;
  const nom=document.getElementById('pm-nom').value;
  const date=document.getElementById('pm-date').value;
  const moment=document.getElementById('pm-moment').value;
