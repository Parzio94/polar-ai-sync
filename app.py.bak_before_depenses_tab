def _cal_upsert_race(r):
    """Crée/met à jour l'événement calendrier d'une course (read-only dans le UI)."""
    import hashlib as _hl
    fp    = _hl.md5(f"race_{r['id']}".encode()).hexdigest()[:12]
    color = r["couleur"]
    title = f"🏁 {r['label']} — {r['objectif']}"
    events = _cal_load()
    events = [e for e in events if e.get("fp") != fp and e.get("race_id") != r["id"]]
    events.append({
        "fp":        fp,
        "title":     title,
        "date":      r["date"],
        "end_date":  r["date"],
        "all_day":   True,
        "start_time":"","end_time":"",
        "color":     color,
        "type":      "race",
        "race_id":   r["id"],
        "created_at":__import__("datetime").datetime.now().isoformat(),
    })
    _cal_save(events)

def _cal_sync_all_races():
    for r in load_races():
        try: _cal_upsert_race(r)
        except: pass

