    option = d.get("option")
    if not option:
        return jsonify({"ok": False, "error": "option manquante"})
    log = load_nutrition_log()
    if any(e["date"] == date_str and e.get("meal","dinner") == "dinner" for e in log):
        return jsonify({"ok": False, "error": "dîner déjà confirmé ce jour"})
    entry = {"date": date_str, "meal": "dinner", **option}
    log.append(entry)
    save_nutrition_log(log)
    fridge = load_nutrition_fridge()
    foods = load_nutrition_foods()
    condiment_ids = {f["id"] for f in foods if f.get("condiment")}
    unit_g_map = {"banane": 120, "oeuf": 60, "avocat": 160, "skyr": 500,
                  "grenailles": 500, "citron": 100}
    for item in option.get("items", []):
        fid = item.get("food_id","")
        if not fid or fid in condiment_ids: continue
        for f in fridge:
            if f["food_id"] == fid:
                f["stock_g"] = max(0, f["stock_g"] - item["qty_g"])
                if f.get("qty_count") and item["food_id"] in unit_g_map:
                    pieces_used = max(1, round(item["qty_g"] / unit_g_map[item["food_id"]]))
                    f["qty_count"] = max(0, f["qty_count"] - pieces_used)
                    if f["qty_count"] == 0: del f["qty_count"]
                break
    save_nutrition_fridge(fridge)
    return jsonify({"ok": True})

