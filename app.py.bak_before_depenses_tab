    def _safe(txt):
        if not txt: return ""
        return str(txt).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")

    def _gmaps_url(coords):
        if not coords: return None
        try: return f"https://maps.google.com/?q={coords['lat']},{coords['lng']}"
        except: return None

    def _short_city(txt):
        """Garde la première partie avant la virgule pour les adresses longues."""
        if not txt: return ""
        parts = str(txt).split(",")
        return parts[0].strip() if len(parts) > 1 else txt

