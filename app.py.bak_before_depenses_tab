            if notes:   block.append(Paragraph(f"Note : {notes}", c_detail))
            gm_dep = _gmaps_url(el.get("coords_depart"))
            if gm_dep and v_dep:
                block.append(Paragraph(f'<link href="{gm_dep}">Google Maps - {v_dep}</link>', c_maps))
