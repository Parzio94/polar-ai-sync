def fc_zone(bpm):
    """Retourne (label_zone, couleur) selon fréquence cardiaque."""
    try: b = int(bpm)
    except: return ("", "#9ca3af")
    for z in load_hr_zones():
        if b <= z["max"]:
            lbl = z.get("lbl") or z.get("zone","Z?")
            return (lbl, z["col"])
    return ("Z5", "#e63946")

def pace_str(pace_val):
    """Convertit allure en secondes/km → 'M:SS/km'. Accepte 'M:SS/km' ou int/float."""
    if isinstance(pace_val,str):
        # Déjà formaté ex '5:32/km'
        return pace_val.replace("/km","") if "/km" in pace_val else pace_val
    try:
        s=float(pace_val)
        return f"{int(s//60)}:{int(s%60):02d}"
    except: return str(pace_val)

def render_splits_km(ex, uid):
    """Affiche le tableau splits km — layout : Km | Allure | Zone | FC (min-max) | Cad. | D (net + détail) | W"""
    splits = ex.get("splits", []) or ex.get("_km_splits", []) or ex.get("_splits_km", [])
    summary = ex.get("_samples_summary", {}) or {}
    elevation = ex.get("_elevation", {}) or {}

    # Badges résumé
    badges = ""
    cad_avg  = ex.get("cadence_avg","") or summary.get("cadence_avg","")
    pace_avg = ex.get("pace_avg","")    or summary.get("pace_avg","")
    pace_best= ex.get("pace_best","")   or summary.get("pace_max","")
    d_plus   = ex.get("elevation_up_m","")   or elevation.get("d_plus","")
    d_minus  = ex.get("elevation_down_m","") or elevation.get("d_minus","")
    pwr_avg  = ex.get("power_avg","") or summary.get("pwr_avg","") or summary.get("power_avg","")
    pwr_max  = ex.get("power_max","") or summary.get("pwr_max","") or summary.get("power_max","")
    if cad_avg:
        badges += (f'<span style="background:#e0f4f6;color:#006d77;font-size:.6rem;font-weight:700;padding:2px 7px;border-radius:5px">'
                   f'👣 {cad_avg} moy ppm</span> ')
    if pace_avg:
        badges += (f'<span style="background:#d8f3dc;color:#2d6a4f;font-size:.6rem;font-weight:700;padding:2px 7px;border-radius:5px">'
                   f'⚡ Moy {pace_str(pace_avg)}/km'
                   f'{" · Best "+pace_str(pace_best)+"/km" if pace_best else ""}'
                   f'</span> ')
    if pwr_avg:
        badges += (f'<span style="background:#f3e8ff;color:#7c3aed;font-size:.6rem;font-weight:700;padding:2px 7px;border-radius:5px">'
                   f'⚡ {pwr_avg}W moy{" · "+str(pwr_max)+"W max" if pwr_max else ""}'
                   f'</span> ')
    if d_plus or d_minus:
        parts = []
        if d_plus: parts.append(f"D+{d_plus}m")
        if d_minus: parts.append(f"D-{d_minus}m")
        badges += (f'<span style="background:#fff3e0;color:#b45309;font-size:.6rem;font-weight:700;padding:2px 7px;border-radius:5px">'
                   f'⛰️ {" · ".join(parts)}</span>')

    badges_html = (f'<div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:5px">{badges}</div>') if badges else ""

    if not splits:
        return ""

    # Détection colonnes disponibles
    has_pace = any(s.get("pace") for s in splits)
    has_hr   = any(s.get("hr_avg") for s in splits)
    has_hrmin= any(s.get("hr_min") is not None for s in splits)
    has_hrmax= any(s.get("hr_max") is not None for s in splits)
    has_zone = has_hr  # Zone = colonne dédiée si FC disponible
    has_cad  = any(s.get("cadence_spm") or s.get("cadence") for s in splits)
    has_elev = any(s.get("d_plus") is not None or s.get("d_minus") is not None for s in splits)
    has_pwr  = any(s.get("pwr_avg") or s.get("power_avg") for s in splits)

    # Calcul allure min/max pour barre couleur
    paces_s = []
    for s in splits:
        p = s.get("pace","")
        if p and ":" in str(p):
            try:
                pp = str(p).replace("/km","").split(":")
                paces_s.append(int(pp[0])*60+int(pp[1]))
            except: pass
    pace_min_s = min(paces_s) if paces_s else 1
    pace_range = max(1, max(paces_s)-pace_min_s) if paces_s else 1

    # ── Styles header / cell ────────────────────────────────────
    TH = 'padding:5px 8px;background:#1a1a2e;color:#fff;font-size:.6rem;font-weight:700;white-space:nowrap;text-align:'
    TD = 'padding:4px 7px;font-size:.63rem;border-bottom:1px solid #e8e4dc;white-space:nowrap;text-align:'

    # ── HEADER ──────────────────────────────────────────────────
    thead = f'<tr><th style="{TH}left">Km</th>'
    if has_pace: thead += f'<th style="{TH}left">⚡ Allure</th>'
    if has_zone: thead += f'<th style="{TH}center">Zone</th>'
    if has_hr:
        fc_header = "❤️ FC"
        if has_hrmin or has_hrmax: fc_header += " <span style=\'font-size:.52rem;opacity:.7\'>(min – max)</span>"
        thead += f'<th style="{TH}center">{fc_header}</th>'
    if has_cad:  thead += f'<th style="{TH}center">🦶 Cad.</th>'
    if has_elev: thead += f'<th style="{TH}center">🏔️ D (D+·D-)</th>'
    if has_pwr:  thead += f'<th style="{TH}center">⚡ W</th>'
    thead += "</tr>"

    # ── ROWS ────────────────────────────────────────────────────
    rows = ""
    for i, s in enumerate(splits):
        bg = "background:#f7f5f0;" if i % 2 == 0 else "background:#fff;"
        row = f'<td style="{TD}left;{bg}font-weight:800;color:#1a1a2e">km {s.get("km","?")}</td>'

        # Allure + barre couleur
        if has_pace:
            p = s.get("pace","")
            if p and ":" in str(p):
                try:
                    pp = str(p).replace("/km","").split(":")
                    p_s = int(pp[0])*60+int(pp[1])
                    pct = round((1-(p_s-pace_min_s)/pace_range)*100)
                    col = "#52b788" if pct>=60 else "#f59e0b" if pct>=30 else "#e63946"
                    bar_w = max(6, pct)
                    row += (f'<td style="{TD}left;{bg}min-width:90px">'
                            f'<div style="display:flex;align-items:center;gap:5px">'
                            f'<span style="font-size:.63rem;font-weight:800;color:{col};min-width:30px">{pace_str(p)}</span>'
                            f'<div style="flex:1;height:5px;border-radius:3px;background:#e8e4dc;min-width:30px">'
                            f'<div style="height:5px;border-radius:3px;background:{col};width:{bar_w}%"></div>'
                            f'</div></div></td>')
                except:
                    row += f'<td style="{TD}left;{bg}color:#9ca3af">—</td>'
            else:
                row += f'<td style="{TD}left;{bg}color:#9ca3af">—</td>'

        # Zone FC — colonne dédiée
        if has_zone:
            bpm = s.get("hr_avg","")
            if bpm:
                zlbl, zcol = fc_zone(bpm)
                row += (f'<td style="{TD}center;{bg}">'
                        f'<span style="background:{zcol};color:#fff;font-size:.58rem;font-weight:800;'
                        f'padding:2px 6px;border-radius:4px">{zlbl}</span></td>')
            else:
                row += f'<td style="{TD}center;{bg}color:#9ca3af">—</td>'

        # FC moy + (min – max) fusionnés
        if has_hr:
            bpm = s.get("hr_avg","")
            if bpm:
                hr_min = s.get("hr_min")
                hr_max = s.get("hr_max")
                minmax = ""
                if hr_min is not None or hr_max is not None:
                    _mn = str(hr_min) if hr_min is not None else "?"
                    _mx = str(hr_max) if hr_max is not None else "?"
                    minmax = (f' <span style="font-size:.55rem;color:#9ca3af;font-weight:400">'
                              f'(<span style="color:#52b788">{_mn}</span>'
                              f' – <span style="color:#e63946">{_mx}</span>)</span>')
                row += (f'<td style="{TD}center;{bg}">'
                        f'<span style="font-size:.65rem;font-weight:800;color:#1a1a2e">{bpm}</span>'
                        f'{minmax}</td>')
            else:
                row += f'<td style="{TD}center;{bg}color:#9ca3af">—</td>'

        # Cadence
        if has_cad:
            cad = s.get("cadence_spm") or s.get("cadence","")
            row += f'<td style="{TD}center;{bg}font-weight:700">{int(cad) if cad else "—"}</td>'

        # Dénivelé : ↑/↓ net + (D+·D-) détail
        if has_elev:
            dp = s.get("d_plus")
            dm = s.get("d_minus")
            d_net = s.get("d_net")
            if d_net is None:
                d_net = (round(dp) if dp else 0) - (round(dm) if dm else 0)
            if dp is not None or dm is not None:
                if d_net > 0:
                    arrow = "↑"; net_col = "#15803d"
                elif d_net < 0:
                    arrow = "↓"; net_col = "#be123c"
                else:
                    arrow = "→"; net_col = "#9ca3af"
                net_str = f"{arrow}{abs(int(d_net))}"
                dp_str = f"+{round(dp)}m" if dp and dp > 0.5 else ""
                dm_str = f"-{round(dm)}m" if dm and dm > 0.5 else ""
                detail = f"({dp_str}{dm_str})" if dp_str or dm_str else ""
                row += (f'<td style="{TD}center;{bg}">'
                        f'<span style="font-size:.65rem;font-weight:800;color:{net_col}">{net_str}</span>'
                        f' <span style="font-size:.55rem;color:#9ca3af">{detail}</span>'
                        f'</td>')
            else:
                row += f'<td style="{TD}center;{bg}color:#9ca3af">—</td>'

        # Puissance
        if has_pwr:
            pw = s.get("pwr_avg") or s.get("power_avg")
            row += f'<td style="{TD}center;{bg}font-weight:700;color:#7c3aed">{str(pw)+"W" if pw else "—"}</td>'

        rows += f"<tr>{row}</tr>"

    # Max 8 lignes visibles, ascenseur si plus
    n = len(splits)
    max_h = "220px" if n > 8 else "auto"
    table = (f'<div style="margin-top:6px;overflow-x:auto;overflow-y:auto;max-height:{max_h}">'
             f'<table style="width:100%;border-collapse:collapse;font-size:.63rem;border-radius:8px;overflow:hidden">'
             f'<thead style="position:sticky;top:0">{thead}</thead><tbody>{rows}</tbody></table></div>')

    sid = f'sp{uid}'
    body = (f'<div class="splits-body" id="{sid}" data-loaded="1">'
            f'{table}'
            f'</div>')

    # Graphique BPM / Allure — bouton lazy-load
    ex_id = (ex.get("_ex_id") or ex.get("id") or
             ex.get("polar-exercise-id") or ex.get("exercise-id") or "")
    if ex_id and str(ex_id).isdigit() and len(str(ex_id)) > 10:
        ex_id = ""
    has_samples = bool(ex.get("_samples_5s"))

    gid = f'graph{uid}'
    graph_btn = ""
    graph_div = ""
    if ex_id:
        lbl_graph = "\u25b6 Graphique BPM / Allure" if not has_samples else "\u25b6 Graphique BPM / Allure"
        graph_btn = (
            f'<button id="gbtn{uid}" class="splits-btn" '
            f'onclick="loadSplitGraph(\'{gid}\',\'{ex_id}\',this,{1 if not has_samples else 0})">'
            f'{lbl_graph}</button>'
        )
        graph_div = f'<div id="{gid}" style="display:none;margin-top:4px"></div>'

    # Les deux boutons sur la même ligne, centrés
    btns = (
        f'<div style="display:flex;gap:6px;margin-top:8px;justify-content:center">'
        f'<button class="splits-btn" id="btn-{sid}" data-sid="{sid}" '
        f'onclick="var s=this.dataset.sid,b=document.getElementById(s);b.classList.toggle(\'open\');'
        f'this.innerHTML=b.classList.contains(\'open\')?\'\u25b2 Masquer d\u00e9tail km\':\'\U0001f4ca D\u00e9tail km\';">'
        f'\U0001f4ca D\u00e9tail km</button>'
        f'{graph_btn}'
        f'</div>'
    )

    return f'{btns}{body}{graph_div}'



SICON={"Course":"🏃","Velo":"🚴","Natation":"🏊","Renfo":"💪","RUNNING":"🏃","CYCLING":"🚴","ROAD_BIKING":"🚴","SWIMMING":"🏊","POOL_SWIMMING":"🏊","OPEN_WATER_SWIMMING":"🏊"}

def get_sport_icon(sport):
    """Retourne l'icône d'un sport — insensible à la casse, aux accents et aux variantes coach IA."""
    if not sport: return "🏅"
    # Lookup direct
    direct = SICON.get(sport)
    if direct: return direct
    # Normalisation : minuscule + suppression accents
    n = sport.lower().replace("é","e").replace("è","e").replace("ê","e").replace("à","a")
    if n in ("velo","velo","cycling","vélo","cycle","bike","road_biking","road biking"): return "🚴"
    if n in ("course","running","run","course a pied","course a pieds"): return "🏃"
    if n in ("natation","swimming","swim","pool_swimming","open_water_swimming","nage"): return "🏊"
    if n in ("renfo","renforcement","musculation","strength"): return "💪"
    if "ski" in n or "skiing" in n: return "⛷️"
    if "velo" in n or "cycling" in n or "bike" in n: return "🚴"
    if "run" in n or "course" in n: return "🏃"
    if "swim" in n or "natation" in n: return "🏊"
    return "🏅"

def get_sport_icon_planning(sport):
    """Comme get_sport_icon mais vélo → 🚵 pour le planning."""
    ico = get_sport_icon(sport)
    return "🚵" if ico == "🚴" else ico


