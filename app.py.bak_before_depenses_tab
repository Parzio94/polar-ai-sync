@app.route("/nutrition")
def nutrition():
    today      = now_local().strftime("%Y-%m-%d")
    fridge     = load_nutrition_fridge()
    foods      = load_nutrition_foods()
    log        = load_nutrition_log()
    options    = generate_dinner_options(today)
    dej        = get_dejeuner_macros(today)
    next_s     = detect_next_session(today)
    tonight    = next((e for e in log if e.get("date") == today and e.get("meal","dinner") == "dinner"), None)
    lunch_today = next((e for e in log if e.get("date") == today and e.get("meal") == "lunch"), None)
    last7      = [(now_local()-timedelta(days=i)).strftime("%Y-%m-%d") for i in range(7)]
    now_dt     = now_local()

    # Protocole course (F3)
    race_proto = get_race_protocol(today)

    # Alerte course clé (J-7) — pour sec_a
    race_alert = None
    if race_proto:
        race_alert = {"name": race_proto["race_name"], "days": race_proto["days_left"],
                      "col": race_proto["color"], "obj": "", "protocol": race_proto["message"]}
    else:
        for rid, rdate, rname, rlabel, robj, rcol in RACES:
            days_left = (rdate - now_dt).days
            if 0 <= days_left <= 7:
                race_alert = {"name": rname, "days": days_left, "col": rcol,
                              "obj": robj, "protocol": _race_protocol(rid, days_left)}
                break

    # Besoins du jour (F6)
    daily_needs = get_daily_needs(today, log)

    # Pré-remplissage déjeuner (F1)
    lunch_prefill = get_lunch_prefill(today, fridge, foods) if not lunch_today else None

    # MOD2 : dépense sportive
    energy_overview = get_energy_overview(today)

    # MOD6 : micronutriments
    micronutrients = get_micronutrients_day(today)

    # Caféine du jour (planning fixe)
    dow = now_dt.weekday()
    caf = 0
    if dow in [0,1,2,5,6]: caf += 80
    if dow in [1,3,4,6]:   caf += 75
    caf_color = "#e63946" if caf > 300 else "#f59e0b" if caf > 200 else "#52b788"
    caf_badge = "🔴" if caf > 300 else "⚠️" if caf > 200 else "✅"

    html = _build_nutrition_html(
        today, fridge, foods, log, options, dej, next_s,
        tonight, lunch_today, last7, race_alert, caf, caf_color, caf_badge,
        race_proto=race_proto, daily_needs=daily_needs, lunch_prefill=lunch_prefill,
        energy_overview=energy_overview, micronutrients=micronutrients
    )
    return page("Nutrition 🥗", html, "/nutrition")



