import hashlib as _hl
CALENDAR_FILE = Path("/root/polar/calendar/calendar_events.json")

def _cal_load():
    if CALENDAR_FILE.exists():
        try:
            import json as _j, hashlib as _hl2
            raw = _j.loads(CALENDAR_FILE.read_text(encoding="utf-8"))
            # Migration : garantir fp et date sur tous les événements
            for e in raw:
                if not e.get("fp"):
                    seed = e.get("id") or (e.get("title","") + e.get("date",""))
                    e["fp"] = _hl2.md5(seed.encode()).hexdigest()[:12]
                if not e.get("date"):
                    e["date"] = "1970-01-01"
            return raw
        except: pass
    return []

def _cal_save(events):
    import json as _j
    CALENDAR_FILE.parent.mkdir(parents=True, exist_ok=True)
    CALENDAR_FILE.write_text(
        _j.dumps(sorted(events, key=lambda e:(e.get("date",""),e.get("start_time",""))),
                 ensure_ascii=False, indent=2),
        encoding="utf-8")

