def _render_element(el, voyage_id):
    el_id   = el.get("id","")
    el_type = el.get("type","activite")
    date    = el.get("date","")
    moment  = el.get("moment","matin")
    st      = el.get("statut","a_reserver")
    resa    = el.get("reservation_requise", False)
    heure      = el.get("heure","")   # ex: "12:30"
    heure_fin  = el.get("heure_fin","")  # ex: "14:15" — transport uniquement

    def _fmt_h(t):
        """'08:21' → '8h21', '09:00' → '9h'"""
        if not t: return ""
        h, _, m = t.partition(":")
        return f"{int(h)}h{m if m and m != '00' else ''}"

    def _short_ville(v):
        """'Paris Gare de l'Est, Place du 11 Novembre' → 'Paris Gare de l'Est'"""
        return v.split(",")[0].strip() if v else ""

    # Préfixe heure : plage "8h21→9h30" pour transport, heure simple sinon
    heure_prefix = ""
    if el.get("type") == "transport" and heure:
        h1 = _fmt_h(heure)
        h2 = _fmt_h(heure_fin)
        plage = f"{h1}→{h2}" if h2 else h1
        heure_prefix = f'<span style="font-weight:900;color:#1a1a2e;margin-right:5px">{plage}</span>'
    elif heure:
        h, _, m = heure.partition(":")
        heure_prefix = f'<span style="font-weight:900;color:#1a1a2e;margin-right:5px">{int(h)}h{m if m and m!="00" else ""}</span>'

    pmin  = el.get("prix_min") or 0
    pmax  = el.get("prix_max", pmin) or pmin
    preel = el.get("prix_reel")
    if pmin == pmax:
        prix_str = f"{int(pmin)}€" if pmin else "—"
    else:
        prix_str = f"{int(pmin)}–{int(pmax)}€"
    if preel:
        prix_str += f' <span style="color:#2d6a4f">/ {int(preel)}€ réel</span>'

    lien = el.get("lien","")

    if el_type == "transport":
        vdep = _short_ville(el.get("ville_depart",""))
        varr = _short_ville(el.get("ville_arrivee",""))
        nom  = f'{_type_ico(el.get("mode","avion"))} {vdep} → {varr}'
        meta_parts = [el.get("mode","").capitalize()]
        if el.get("distance_km"): meta_parts.append(f'{el["distance_km"]} km vol d\'oiseau')
        if el.get("ref_confirmation"): meta_parts.append(f'Réf: {el["ref_confirmation"]}')
        c1 = el.get("coords_depart"); c2 = el.get("coords")
        if c1 and c2:
            gm = lien_google_maps(c1, c2)
            meta_parts.append(f'<a href="{gm}" target="_blank" style="color:#1565c0;font-size:.6rem">📍 Maps</a>')
        meta = " · ".join(filter(None, meta_parts))
    elif el_type == "hotel":
        evt     = el.get("type_evenement","nuit")
        evt_lbl = {"checkin":"Check-in","checkout":"Check-out","nuit":"Nuit"}.get(evt, evt)
        nom_h   = el.get("nom", el.get("nom_etablissement","Hôtel"))
        nom     = f'🏨 {nom_h} — {evt_lbl}'
        meta_parts = [el.get("ville","")]
        if el.get("ref_confirmation"): meta_parts.append(f'Réf: {el["ref_confirmation"]}')
        meta = " · ".join(filter(None, meta_parts))
    elif el_type == "activite":
        nom  = f'🎟️ {el.get("nom","Activité")}'
        meta_parts = [el.get("ville","")]
        if el.get("ref_confirmation"): meta_parts.append(f'Réf: {el["ref_confirmation"]}')
        meta = " · ".join(filter(None, meta_parts))
    elif el_type == "note":
        titre   = el.get("titre","Note")
        contenu = el.get("contenu","")
        # Rendu spécial pour les notes — fond jaune, pas de prix/statut
        lien_btn  = ""
        resa_html = ""
        el_id_safe = el_id
        return (f'<div class="voy-element" style="background:#fffde7;border-left:3px solid #f59e0b;padding-left:8px">'
                f'<div class="voy-element-info">'
                f'<div class="voy-element-name">{heure_prefix}📝 <strong>{titre}</strong></div>'
                f'{"<div style=\"font-size:.65rem;color:#4a4a6a;font-style:italic;margin-top:2px\">" + contenu + "</div>" if contenu else ""}'
                f'</div>'
                f'<div class="voy-element-actions">'
                f'<button class="voy-edit-btn" onclick="voyOpenEditElement(\'{voyage_id}\',\'{el_id_safe}\')" title="Modifier">✏️</button>'
                f'<button class="voy-del-btn" onclick="voyDeleteElement(\'{voyage_id}\',\'{el_id_safe}\')" title="Supprimer">&times;</button>'
                f'</div>'
                f'</div>')
    else:  # nourriture
        nom  = f'🍽️ {el.get("nom","Restaurant")}'
        meta = el.get("ville","")
        lien = ""

    lien_btn  = f'<a class="voy-link-btn" href="{lien}" target="_blank" title="Lien réservation">🔗</a>' if lien else ""
    resa_html = '<span class="voy-resa-badge">⚠️ Résa</span>' if resa else ""

    return (f'<div class="voy-element" draggable="true" '
            f'ondragstart="voyDragStart(event,\'{voyage_id}\',\'{el_id}\')" '
            f'ondragend="voyDragEnd(event)">'
            f'<span style="cursor:grab;color:#d1d5db;font-size:1rem;padding:0 4px 0 0;flex-shrink:0;user-select:none">⠿</span>'
            f'<div class="voy-element-info">'
            f'<div class="voy-element-name">{heure_prefix}{nom}</div>'
            f'<div class="voy-element-meta">{meta}</div>'
            f'</div>'
            f'<div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px">'
            f'<span class="voy-element-prix">{prix_str}</span>'
            f'{_statut_badge(st)}'
            f'{resa_html}'
            f'</div>'
            f'<div class="voy-element-actions">'
            f'{lien_btn}'
            f'<button class="voy-edit-btn" onclick="voyOpenEditElement(\'{voyage_id}\',\'{el_id}\')" title="Modifier">✏️</button>'
            f'<button class="voy-del-btn" onclick="voyDeleteElement(\'{voyage_id}\',\'{el_id}\')" title="Supprimer">&times;</button>'
            f'</div>'
            f'</div>')


def _render_jour(voyage, date_str, voyage_id):
    # Ville du jour (remplace les étapes)
    ville_du_jour = voyage.get("villes_par_jour", {}).get(date_str, "")
    ville_html = ""
    if ville_du_jour:
        ville_html = f' — <span style="color:#1565c0;font-weight:600">📍 {ville_du_jour}</span>'

    moments = elements_du_jour(voyage, date_str)
    sections_html = ""
    for mom_key, mom_label in [("matin","🌅 Matin"),("midi","☀️ Midi"),("aprem","🌤️ Après-midi"),("soir","🌙 Soir")]:
        els      = moments.get(mom_key, [])
        # Trier par heure si disponible
        els      = sorted(els, key=lambda e: e.get("heure","") or "")
        els_html = "".join(_render_element(el, voyage_id) for el in els)
        sections_html += (f'<div class="voy-section" '
                          f'ondragover="voyDragOver(event)" '
                          f'ondragleave="voyDragLeave(event)" '
                          f'ondrop="voyDrop(event,\'{voyage_id}\',\'{date_str}\',\'{mom_key}\')">'
                          f'<div class="voy-section-label">{mom_label}</div>'
                          f'{els_html}'
                          f'<button class="voy-add-btn" onclick="voyOpenAdd(\'{voyage_id}\',\'{date_str}\',\'{mom_key}\')">+ Ajouter</button>'
                          f'</div>')

    return (f'<div class="voy-jour">'
            f'<div class="voy-jour-head" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">'
            f'<span>📅 {_fmt_date_fr(date_str)}{ville_html}</span>'
            f'<input type="text" value="{ville_du_jour}" placeholder="📍 Ville..." '
            f'style="border:none;border-bottom:1px dashed #d1d5db;background:transparent;'
            f'font-size:.65rem;color:#4a4a6a;outline:none;width:90px;padding:1px 3px;cursor:text" '
            f'onchange="voySetVille(\'{voyage_id}\',\'{date_str}\',this.value)" '
            f'onfocus="this.style.borderBottomColor=\'#1565c0\'" '
            f'onblur="this.style.borderBottomColor=\'#d1d5db\'">'
            f'</div>'
            f'{sections_html}'
            f'</div>')


