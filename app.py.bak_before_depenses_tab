@app.route("/api/coach/run", methods=["POST"])
def api_coach_run():
    import subprocess as _sp
    body    = request.get_json() or {}
    context = body.get("context", "").strip()
    coach_script = POLAR / "coach_weekly.py"
    if not coach_script.exists():
        return jsonify({"ok": False, "error": "coach_weekly.py introuvable dans " + str(POLAR)})
    api_key = os.getenv("ANTHROPIC_API_KEY", "")
    if not api_key:
        return jsonify({"ok": False, "error": "ANTHROPIC_API_KEY non définie"})
    cmd = [str(VENV_PY), str(coach_script)]
    if context:
        cmd += ["--context", context]
    env = {**os.environ, "ANTHROPIC_API_KEY": api_key}
    try:
        result = _sp.run(cmd, capture_output=True, text=True, timeout=120, env=env)
        if result.returncode != 0:
            return jsonify({"ok": False, "error": result.stderr[-500:] if result.stderr else "Erreur inconnue"})
        return jsonify({"ok": True})
    except _sp.TimeoutExpired:
        return jsonify({"ok": False, "error": "Timeout (>120s)"})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)})


@app.route("/api/coach/apply", methods=["POST"])
def api_coach_apply():
    import datetime as _datetime
    body   = request.get_json() or {}
    action = body.get("action", "apply")
    analysis_file = POLAR / "analysis_current.json"
    if action == "reject":
        try:
            if analysis_file.exists(): analysis_file.unlink()
            return jsonify({"ok": True})
        except Exception as e: return jsonify({"ok": False, "error": str(e)})
    if action == "apply_z2_pace":
        try:
            analysis = json.loads(analysis_file.read_text(encoding="utf-8"))
            zone_calib = analysis.get("zone_calib", {})
            pace_str = zone_calib.get("proposed_z2_pace_str")
            if not pace_str:
                return jsonify({"ok": False, "error": "Pas de recalibration Z2 disponible"})
            zones_file = POLAR / "hr_zones.json"
            zones = json.loads(zones_file.read_text(encoding="utf-8"))
            updated = False
            for z in zones:
                if z.get("zone") == "Z2" or z.get("lbl") == "Z2":
                    z["pace"] = pace_str
                    z["updated_at"] = __import__("datetime").datetime.now().strftime("%Y-%m-%d")
                    updated = True
            if not updated:
                return jsonify({"ok": False, "error": "Zone Z2 introuvable dans hr_zones.json"})
            tmp = str(zones_file) + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f: json.dump(zones, f, ensure_ascii=False, indent=2)
            os.replace(tmp, str(zones_file))
            # Marquer comme appliqué
            analysis["zone_calib"]["validated"] = True
            tmp2 = str(analysis_file) + ".tmp"
            with open(tmp2, "w", encoding="utf-8") as f: json.dump(analysis, f, ensure_ascii=False, indent=2)
            os.replace(tmp2, str(analysis_file))
            return jsonify({"ok": True})
        except Exception as e: return jsonify({"ok": False, "error": str(e)})
        try:
            analysis = json.loads(analysis_file.read_text(encoding="utf-8"))
            pending  = analysis.get("pending_updates", {})
            zones    = pending.get("data") if pending else None
            if not zones: return jsonify({"ok": False, "error": "Pas de zones en attente"})
            zones_file = POLAR / "hr_zones.json"
            tmp = str(zones_file) + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f: json.dump(zones, f, ensure_ascii=False, indent=2)
            os.replace(tmp, str(zones_file))
            analysis["pending_updates"] = None
            tmp2 = str(analysis_file) + ".tmp"
            with open(tmp2, "w", encoding="utf-8") as f: json.dump(analysis, f, ensure_ascii=False, indent=2)
            os.replace(tmp2, str(analysis_file))
            return jsonify({"ok": True})
        except Exception as e: return jsonify({"ok": False, "error": str(e)})
    try:
        if analysis_file.exists():
            analysis = json.loads(analysis_file.read_text(encoding="utf-8"))
            analysis["validated"] = True
            analysis["validated_at"] = _datetime.datetime.now().isoformat()
            tmp = str(analysis_file) + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f: json.dump(analysis, f, ensure_ascii=False, indent=2)
            os.replace(tmp, str(analysis_file))
            # Sync sub_proposes → races.json
            sub_proposes = analysis.get("sub_proposes", {})
            if sub_proposes:
                races = load_races()
                updated = False
                for r in races:
                    rid = r.get("id","")
                    if rid in sub_proposes:
                        sp = sub_proposes[rid]
                        r["objectif"]        = f'Sub {sp["sub_cible"]}'
                        r["sub_cible"]       = sp.get("sub_cible","")
                        r["allure_cible"]    = sp.get("allure_cible")
                        r["probabilite_pct"] = sp.get("probabilite_pct")
                        r["coach_note"]      = sp.get("note","")
                        r["updated_at"]      = _datetime.datetime.now().strftime("%Y-%m-%d")
                        updated = True
                if updated:
                    save_races(races)
                    for r in races:
                        try: _cal_upsert_race(r)
                        except: pass
        return jsonify({"ok": True})
    except Exception as e: return jsonify({"ok": False, "error": str(e)})


