def _cal_voyage_fp(vid):
    """Fingerprint stable pour un événement voyage dans le calendrier."""
    import hashlib as _hl
    return _hl.md5(f"voyage_{vid}".encode()).hexdigest()[:12]

def _cal_upsert_voyage(voyage):
    """Crée ou met à jour l'événement calendrier d'un voyage (utilise fp standard)."""
    vid   = voyage["id"]
    fp    = _cal_voyage_fp(vid)
    ico   = {"avion":"✈️","velo":"🚴","road_trip":"🚗","train":"🚂"}.get(voyage.get("type",""),"🌍")
    title = f'{ico} {voyage["nom"]}'
    events = _cal_load()
    # Supprimer toute ancienne version (fp OU ancien id-based)
    events = [e for e in events if e.get("fp") != fp and e.get("id") != f'voyage_{vid}']
    events.append({
        "fp":          fp,
        "title":       title,
        "date":        voyage["date_debut"],
        "end_date":    voyage["date_fin"],
        "all_day":     True,
        "start_time":  "",
        "end_time":    "",
        "color":       "#f59e0b",
        "type":        "voyage",
        "voyage_id":   vid,
        "created_at":  __import__("datetime").datetime.now().isoformat(),
    })
    _cal_save(events)

def _cal_remove_voyage(vid):
    """Supprime l'événement calendrier d'un voyage."""
    fp = _cal_voyage_fp(vid)
    events = [e for e in _cal_load()
              if e.get("fp") != fp and e.get("id") != f'voyage_{vid}']
    _cal_save(events)

def _cal_transport_fp(eid):
    """Fingerprint stable pour un événement transport dans le calendrier."""
    import hashlib as _hl
    return _hl.md5(f"transport_{eid}".encode()).hexdigest()[:12]

_MODE_LABELS = {"avion":"Avion","train":"Train","voiture":"Voiture","velo":"Vélo","ferry":"Ferry"}
_MODE_ICONS  = {"avion":"✈️","train":"🚂","voiture":"🚗","velo":"🚴","ferry":"⛴️"}

def _cal_upsert_transport(el, vid=None):
    """Crée/met à jour un événement calendrier pour un élément transport."""
    eid  = el.get("id","")
    if not eid: return
    fp   = _cal_transport_fp(eid)
    mode = el.get("mode","avion")
    ico  = _MODE_ICONS.get(mode, "🚌")

    # Villes tronquées à la première virgule
    vdep = (el.get("ville_depart","?") or "?").split(",")[0].strip()
    varr = (el.get("ville_arrivee","?") or "?").split(",")[0].strip()

    # Plage horaire
    def _fmt_h(t):
        if not t: return ""
        h, _, m = str(t).partition(":")
        return f"{int(h)}h{m if m and m != '00' else ''}"

    h1 = _fmt_h(el.get("heure",""))
    h2 = _fmt_h(el.get("heure_fin",""))
    plage = f"{h1}\u2192{h2} " if h1 and h2 else (f"{h1} " if h1 else "")

    title = f"{plage}{ico} {vdep} \u2192 {varr}"
    date  = el.get("date","")
    if not date: return
    events = _cal_load()
    events = [e for e in events if e.get("fp") != fp]
    events.append({
        "fp":         fp,
        "title":      title,
        "date":       date,
        "end_date":   date,
        "all_day":    True,
        "start_time": el.get("heure",""),
        "end_time":   el.get("heure_fin",""),
        "color":      "#3b82f6",
        "type":       "transport",
        "voyage_id":  vid or "",
        "element_id": eid,
        "created_at": __import__("datetime").datetime.now().isoformat(),
    })
    _cal_save(events)

def _cal_remove_transport(eid):
    """Supprime l'événement calendrier d'un élément transport."""
    fp = _cal_transport_fp(eid)
    events = [e for e in _cal_load() if e.get("fp") != fp]
    _cal_save(events)


