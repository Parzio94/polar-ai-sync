    if not api_key:
        return jsonify({"ok": False, "error": "Clé ANTHROPIC_API_KEY manquante dans .env"})

    # ── F5 : Anti-doublon par hash SHA256 ──
    try:
        raw_bytes = _b64.b64decode(image_b64)[:4096]
        img_hash  = _hl.sha256(raw_bytes).hexdigest()
        hashes_f  = POLAR / "ticket_hashes.json"
        hashes    = json.loads(hashes_f.read_text()) if hashes_f.exists() else []
        for h in hashes:
            if h.get("hash") == img_hash:
                return jsonify({"ok": False, "error": f"⚠️ Ce ticket a déjà été scanné le {h.get('date','?')}", "duplicate": True})
    except Exception:
        img_hash, hashes, hashes_f = None, [], POLAR / "ticket_hashes.json"

    # Détecter le type MIME réel depuis les magic bytes
    try:
        raw = _b64.b64decode(image_b64[:16])
        if raw[:8] == b'\x89PNG\r\n\x1a\n':
            media_type = "image/png"
        elif raw[:4] == b'GIF8':
            media_type = "image/gif"
        elif raw[:4] == b'RIFF' or raw[6:10] in (b'JFIF', b'Exif'):
            media_type = "image/jpeg"
        else:
            media_type = "image/jpeg"
    except Exception:
        media_type = "image/jpeg"
    known_ids = (
        "poulet_filet,boeuf,porc,filet_mignon_porc,saucisse_porc,lardons,jambon_blanc,"
        "saumon_fume,dinde,thon,crevette,oeuf,"
        "fromage_chevre,skyr,camembert,brie,comte,emmental,mozzarella,"
        "pates_cuites,riz_cuit,pain,banane,chocolat_noir,avocat,tomate,"
        "fraises,epinards,grenailles,miel,citron"
    )
    prompt_text = (
        "Tu analyses une photo de ticket de caisse de supermarché.\n\n"
        "ZONE À ANALYSER :\n"
        "- Commence à lire après la ligne 'Description' (ou le premier article avec un prix en € à droite)\n"
        "- Arrête-toi à la ligne '----------' ou 'Nombre X art.' ou 'TOTAL'\n"
        "- LIS ABSOLUMENT CHAQUE LIGNE dans cette zone, sans exception\n\n"
        "POUR CHAQUE LIGNE :\n"
        "1. Est-ce un article alimentaire ? (viande, poisson, œuf, fromage, légume, fruit, féculent, laitage, condiment, boisson non-alcoolisée)\n"
        "   → OUI : l'inclure dans le JSON\n"
        "   → NON (produit ménager, hygiène, alcool, tabac, emballage, journal) : ignorer complètement\n\n"
        "2. Correspondances noms abrégés → food_id :\n"
        "   SRNG PORC XXL / SERINGUE PORC / FILET MIGNON → filet_mignon_porc\n"
        "   SAUCISSE PORC / CHIPOLATA / MERGUEZ / KNACK → saucisse_porc\n"
        "   SCE PORC / ECHINE PORC / COTE PORC / PORC (générique) → porc\n"
        "   POULET ROT / BLANC POULET / FILET PLD / POULET → poulet_filet\n"
        "   BOEUF HACH / STEAK HACH / VIANDE BOV / BOEUF → boeuf\n"
        "   SAUMON FUM / SAU FUM → saumon_fume\n"
        "   OEUFS / BTE OEUFS / BOITE 6 / BOITE 10 / BOITE 12 → oeuf\n"
        "   DINDE / ESC DINDE / ESCALOPE DIN → dinde\n"
        "   JAMBON / JAMB / JAMBON BLANC → jambon_blanc\n"
