@app.route("/api/calendar/create", methods=["POST"])
def api_cal_create():
    data = request.get_json() or {}
    title = (data.get("title") or "").strip()
    date  = (data.get("date") or "").strip()
    if not title or not date:
        return jsonify({"ok": False})
    recur = data.get("recur", "none")
    recur_id = str(uuid.uuid4())[:8] if recur != "none" else None
    fp0 = str(uuid.uuid4())[:12]
    events = _cal_load()
    # Générer les occurrences de récurrence
    from datetime import datetime as _dt, timedelta as _td
    dates = [date]
    if recur in ("weekly","biweekly","monthly"):
        try:
            d = _dt.strptime(date, "%Y-%m-%d")
            step = {"weekly":7,"biweekly":14,"monthly":30}[recur]
            for i in range(1, 12):
                d2 = d + _td(days=step*i)
                dates.append(d2.strftime("%Y-%m-%d"))
        except: pass
    new_fps = []
    for i, dt_str in enumerate(dates):
        end_dt = (data.get("end_date") or date).strip()
        if i > 0:
            # Décaler end_date proportionnellement
            try:
                from datetime import datetime as _dt2
                d_start = _dt2.strptime(date, "%Y-%m-%d")
                d_end   = _dt2.strptime(end_dt, "%Y-%m-%d")
                diff    = (d_end - d_start).days
                d_new   = _dt2.strptime(dt_str, "%Y-%m-%d")
                end_dt  = (d_new + _td(days=diff)).strftime("%Y-%m-%d")
            except: end_dt = dt_str
        fp = fp0 if i == 0 else str(uuid.uuid4())[:12]
        ev = {
            "fp": fp,
            "title": title,
            "date": dt_str,
            "end_date": end_dt,
            "all_day": not bool((data.get("start_time") or "").strip()),
            "start_time": (data.get("start_time") or "").strip(),
            "end_time": (data.get("end_time") or "").strip(),
            "color": (data.get("color") or "#1a1a2e").strip(),
            "type": (data.get("type") or "autre").strip(),
            "recur": recur,
            "recur_id": recur_id,
            "created_at": __import__("datetime").datetime.now().isoformat()
        }
        events.append(ev)
        new_fps.append(fp)
    _cal_save(events)
    return jsonify({"ok": True, "fp": fp0, "recur_id": recur_id, "count": len(new_fps)})

@app.route("/api/calendar/update", methods=["POST"])
def api_cal_update():
    data = request.get_json() or {}
    fp    = (data.get("fp") or "").strip()
    title = (data.get("title") or "").strip()
    date  = (data.get("date") or "").strip()
    all_recur = data.get("all_recur", False)
    if not fp or not title or not date:
        return jsonify({"ok": False, "error": "fp/title/date requis"})
    events = _cal_load()
    # Trouver le recur_id si all_recur
    recur_id = None
    if all_recur:
        for ev in events:
            if ev.get("fp") == fp:
                recur_id = ev.get("recur_id")
                break
    updated = False
    for ev in events:
        if ev.get("fp") == fp or (all_recur and recur_id and ev.get("recur_id") == recur_id):
            ev["title"]      = title
            ev["end_date"]   = (data.get("end_date") or date).strip()
            ev["start_time"] = (data.get("start_time") or "").strip()
            ev["end_time"]   = (data.get("end_time") or "").strip()
            ev["all_day"]    = not bool(ev["start_time"])
            ev["color"]      = (data.get("color") or "#1a1a2e").strip()
            ev["type"]       = (data.get("type") or "autre").strip()
            if ev.get("fp") == fp:
                ev["date"] = date
            updated = True
    if updated:
        _cal_save(events)
        return jsonify({"ok": True})
    return jsonify({"ok": False, "error": "Événement non trouvé"})

@app.route("/api/calendar/delete", methods=["POST"])
def api_cal_delete():
    data = request.get_json() or {}
    fp = data.get("fp","")
    all_recur = data.get("all_recur", False)
    events = _cal_load()
    if all_recur:
        recur_id = next((e.get("recur_id") for e in events if e.get("fp") == fp), None)
        if recur_id:
            events = [e for e in events if e.get("recur_id") != recur_id]
        else:
            events = [e for e in events if e.get("fp") != fp]
    else:
        events = [e for e in events if e.get("fp") != fp]
    _cal_save(events)
    return jsonify({"ok": True})

