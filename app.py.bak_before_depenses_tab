@app.route("/api/calendar/exercises")
def api_cal_exercises():
    """Retourne séances Polar (réalisées) + programme (planifiées) pour le calendrier."""
    exercises = load_exercises()
    programme = _load_programme()  # toujours frais depuis les fichiers
    result = {}

    SPORT_ICO = {
        "RUNNING":       "🏃",
        "CYCLING":       "🚴",
        "SWIMMING":      "🏊",
        "POOL_SWIMMING": "🏊",
        "DOWNHILL_SKIING":"⛷️",
        "OTHER":         "🏅",
        # programme
        "Course":   "🏃",
        "Velo":     "🚴",
        "Natation": "🏊",
        "Renfo":    "💪",
    }
    SPORT_COL = {
        "RUNNING":"#1565c0","Course":"#1565c0",
        "CYCLING":"#2d6a4f","Velo":"#2d6a4f",
        "SWIMMING":"#006d77","POOL_SWIMMING":"#006d77","Natation":"#006d77",
        "DOWNHILL_SKIING":"#7c3aed",
        "Renfo":"#b45309",
        "OTHER":"#888",
    }

    # 1. Séances réalisées (Polar)
    for ex in exercises:
        date = (ex.get("start-time") or ex.get("date",""))[:10]
        if not date: continue
        sport = ex.get("sport","OTHER")
        dur   = ex.get("duration_s") or parse_duration(ex.get("duration","")) or 0
        dist  = ex.get("distance_m") or ex.get("distance",0) or 0
        entry = {
            "sport":   sport,
            "ico":     get_sport_icon(sport),
            "dur_min": round(float(dur)/60) if dur else 0,
            "dist_km": round(float(dist)/1000,1) if dist else 0,
        }
        result.setdefault(date,[]).append(entry)

    # 2. Séances planifiées (programme)
    realise_keys = set()
    for date, entries in result.items():
        for e in entries:
            realise_keys.add(f"{date}_{e['sport']}")

    for sem_name, sem_data in programme.items():
        for s in sem_data.get("seances", []):
            date  = s.get("date","")
            sport = s.get("sport","")
            if not date or not sport: continue
            # Ne pas dupliquer si déjà réalisé ce jour-là (même discipline)
            polar_sport = {"Course":"RUNNING","Velo":"CYCLING","Natation":"SWIMMING","Natation":"POOL_SWIMMING"}.get(sport,sport)
            if (f"{date}_{polar_sport}" in realise_keys or
                f"{date}_{sport}" in realise_keys or
                f"{date}_POOL_SWIMMING" in realise_keys and sport == "Natation" or
                f"{date}_CYCLING" in realise_keys and sport == "Velo" or
                f"{date}_RUNNING" in realise_keys and sport == "Course"):
                continue
            entry = {
                "sport":   sport,
                "ico":     get_sport_icon(sport),
                "col":     SPORT_COL.get(sport, "#888"),
                "type":    "planifie",
                "dur_min": 0,
                "dist_km": s.get("dist_cible") or 0,
            }
            result.setdefault(date,[]).append(entry)

    return jsonify(result)


