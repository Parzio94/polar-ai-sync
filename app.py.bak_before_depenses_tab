def _sem_dates(sem_data):
    """Calcule la plage de dates d'une semaine depuis ses séances ex: '24/02–01/03'."""
    try:
        dates = sorted(s["date"] for s in sem_data.get("seances", []))
        if not dates: return ""
        d1 = datetime.strptime(dates[0], "%Y-%m-%d")
        d2 = datetime.strptime(dates[-1], "%Y-%m-%d")
        return f"{d1.day:02d}/{d1.month:02d}–{d2.day:02d}/{d2.month:02d}"
    except Exception:
        return ""

@app.route("/planning")
def planning():
    global PROGRAMME
    PROGRAMME = _load_programme()
    now=now_local()
    today=now.strftime("%Y-%m-%d")
    exercises=load_exercises()
    ex_map=exercises_by_date_sport(exercises)

    def find_actual(date,sport):
        ps={"Course":"RUNNING","Velo":"CYCLING","Natation":"SWIMMING"}.get(sport,sport)
        return ex_map.get(f"{date}_{ps}")

    # Calculer le numéro de semaine depuis la position dans PROGRAMME (trié par date de début)
    def get_sem_num(sem_key):
        sorted_keys = sorted(PROGRAMME.keys(),
            key=lambda k: min(s["date"] for s in PROGRAMME[k]["seances"]) if PROGRAMME[k]["seances"] else "9999")
        try: return sorted_keys.index(sem_key) + 1
        except: return "?"

    # Déterminer les semaines à afficher : courante + toutes les futures
    # Une semaine est "passée" si sa dernière séance est avant aujourd'hui
    sems_to_show = []
    for sem_key, sem_data in sorted(PROGRAMME.items(),
            key=lambda x: min(s["date"] for s in x[1]["seances"]) if x[1]["seances"] else "9999"):
        if not sem_data["seances"]: continue
        dates = [s["date"] for s in sem_data["seances"]]
        # Afficher si la semaine n'est pas entièrement passée
        if max(dates) >= today:
            sems_to_show.append(sem_key)

    # Bouton modifier programme — centré, hors des cards, séparation visuelle nette
    btn_prog = ('<div style="padding:4px 0 20px;text-align:center;">'
               '<a href="/programme-upload" style="display:inline-flex;align-items:center;gap:8px;'
               'padding:11px 24px;background:rgba(124,58,237,.1);border:2px solid rgba(124,58,237,.45);'
               'border-radius:12px;color:#7c3aed;font-size:.78rem;font-weight:700;text-decoration:none;'
               'box-shadow:0 2px 8px rgba(124,58,237,.12)">'
               '📋 Modifier le programme</a></div>')
    content_sems=btn_prog
    for sem_key in sems_to_show:
        sem_data=PROGRAMME[sem_key]
        enriched=enrich_swim(sem_data["seances"])
        sem_num = get_sem_num(sem_key)

        # Volumes réalisés vs prévus
        course_cible=sum(s.get("dist_cible",0) or 0 for s in enriched if s["sport"]=="Course")
        course_done=sum(
            (ex_map.get(f'{s["date"]}_RUNNING') or {}).get("distance",0) or 0
            for s in enriched if s["sport"]=="Course")/1000
        course_done_h=sum(
            parse_duration((ex_map.get(f'{s["date"]}_RUNNING') or {}).get("duration"))
            for s in enriched if s["sport"]=="Course")/3600

        nat_cible=sum(s.get("dist_cible_m") or 0 for s in enriched if s["sport"]=="Natation")
        nat_done_m=sum(
            s.get("dist_cible_m") or 0
            for s in enriched if s["sport"]=="Natation" and (ex_map.get(f'{s["date"]}_SWIMMING') or ex_map.get(f'{s["date"]}_POOL_SWIMMING')))
        nat_done_h=sum(
            parse_duration((ex_map.get(f'{s["date"]}_SWIMMING') or {}).get("duration"))
            for s in enriched if s["sport"]=="Natation" and (ex_map.get(f'{s["date"]}_SWIMMING') or ex_map.get(f'{s["date"]}_POOL_SWIMMING')))/3600

        # Vélo — toujours affiché même si 0 séances
        velo_seances=[s for s in enriched if s["sport"]=="Velo"]
        velo_cible_h=0
        for vs in velo_seances:
            dur_str=vs.get("duree","")
            m_dur=re.search(r'(\d+)',dur_str)
            if m_dur: velo_cible_h+=int(m_dur.group(1))/60
        velo_done_h=sum(
            parse_duration((ex_map.get(f'{s["date"]}_CYCLING') or ex_map.get(f'{s["date"]}_ROAD_BIKING') or {}).get("duration"))
            for s in velo_seances if ex_map.get(f'{s["date"]}_CYCLING') or ex_map.get(f'{s["date"]}_ROAD_BIKING'))/3600
        velo_done_km=sum(
            (ex_map.get(f'{s["date"]}_CYCLING') or ex_map.get(f'{s["date"]}_ROAD_BIKING') or {}).get("distance",0) or 0
            for s in velo_seances if ex_map.get(f'{s["date"]}_CYCLING') or ex_map.get(f'{s["date"]}_ROAD_BIKING'))/1000
        velo_cible_km=sum(s.get("dist_cible",0) or 0 for s in velo_seances)
        velo_speed=round(velo_done_km/velo_done_h,1) if velo_done_h>0 else 0

        pct_c=min(100,round(course_done/course_cible*100)) if course_cible else 0
        pct_n=min(100,round(nat_done_m/nat_cible*100)) if nat_cible else 0
        pct_v_km=min(100,round(velo_done_km/velo_cible_km*100)) if velo_cible_km else (min(100,round(velo_done_h/velo_cible_h*100)) if velo_cible_h else 0)

        nat_est_min=int(nat_cible/100*2) if nat_cible else 0
        nat_est_str=f"~{nat_est_min//60}h{nat_est_min%60:02d}" if nat_est_min>=60 else f"~{nat_est_min}min"

        # Tuiles — couleurs cohérentes avec historique (rouge, bleu, jaune)
        tiles=""
        # Course — toujours affiché
        if True:
            tiles+=(f'<div style="flex:1;background:#fde8e8;border-radius:9px;padding:8px 10px">'
                    f'<div style="font-size:.62rem;font-weight:700;color:#e63946;text-transform:uppercase;letter-spacing:.06em">🏃 Course</div>'
                    f'<div style="font-size:1.1rem;font-weight:800;color:#e63946;margin-top:2px">{course_done:.1f} <span style="font-size:.7rem;font-weight:400">/ {course_cible:.1f} km</span></div>'
                    f'<div style="height:4px;background:#fff;border-radius:2px;margin-top:4px;overflow:hidden">'
                    f'<div style="height:100%;width:{pct_c}%;background:#e63946;border-radius:2px"></div></div>'
                    f'<div style="font-size:.6rem;color:#e63946;margin-top:2px">'
                    f'{"✅ "+fmt_dur(int(course_done_h*3600))+" réalisé" if course_done_h>0 else "—"}'
                    f'</div></div>')
        # Natation — toujours affiché
        if True:
            tiles+=(f'<div style="flex:1;background:#dbeafe;border-radius:9px;padding:8px 10px">'
                    f'<div style="font-size:.62rem;font-weight:700;color:#1d4ed8;text-transform:uppercase;letter-spacing:.06em">🏊 Natation</div>'
                    f'<div style="font-size:1.1rem;font-weight:800;color:#1d4ed8;margin-top:2px">{nat_done_m} <span style="font-size:.7rem;font-weight:400">/ {nat_cible} m</span></div>'
                    f'<div style="height:4px;background:#fff;border-radius:2px;margin-top:4px;overflow:hidden">'
                    f'<div style="height:100%;width:{pct_n}%;background:#1d4ed8;border-radius:2px"></div></div>'
                    f'<div style="font-size:.6rem;color:#1d4ed8;margin-top:2px">'
                    f'{"✅ "+fmt_dur(int(nat_done_h*3600))+" réalisé" if nat_done_h>0 else nat_est_str+" estimé"}'
                    f'</div></div>')
        # Vélo — TOUJOURS affiché (même à 0)
        if velo_cible_km:
            _velo_main=f'{velo_done_km:.1f} <span style="font-size:.7rem;font-weight:400">/ {velo_cible_km:.1f} km</span>'
        elif velo_cible_h:
            _velo_main=f'{"%.1f km" % velo_done_km if velo_done_km else "—"} <span style="font-size:.7rem;font-weight:400">/ {"%.1fh" % velo_cible_h} prévu</span>'
        else:
            _velo_main='<span style="font-size:.7rem;font-weight:400">0 km</span>'
        _velo_sub=(f'✅ {fmt_dur(int(velo_done_h*3600))} · {velo_speed} km/h' if velo_done_h>0
                   else (f'~{"%.1fh" % velo_cible_h} prévu' if velo_cible_h else "Aucune séance"))
        tiles+=(f'<div style="flex:1;background:#fef9c3;border-radius:9px;padding:8px 10px">'
                f'<div style="font-size:.62rem;font-weight:700;color:#b45309;text-transform:uppercase;letter-spacing:.06em">🚵 Vélo</div>'
                f'<div style="font-size:1.1rem;font-weight:800;color:#b45309;margin-top:2px">{_velo_main}</div>'
                f'<div style="height:4px;background:#fff;border-radius:2px;margin-top:4px;overflow:hidden">'
                f'<div style="height:100%;width:{pct_v_km}%;background:#b45309;border-radius:2px"></div></div>'
                f'<div style="font-size:.6rem;color:#b45309;margin-top:2px">{_velo_sub}</div>'
