def sync_alert_banner():
    """
    Bannière rouge si les données sont absentes ou trop vieilles.
    Source : week_current.json (généré à chaque sync par polar_daily.py).
    """
    week_current = DATA / "weeks" / "week_current.json"
    try:
        if not week_current.exists():
            return ('<div style="background:#e63946;color:#fff;text-align:center;'
                    'padding:6px 14px;font-size:.72rem;font-weight:700;z-index:150">'
                    '⚠️ Aucune donnée — Lance une sync manuelle</div>')

        d = json.loads(week_current.read_text())
        nb_ex   = len(d.get("exercises", []))
        generated = d.get("generated", d.get("generated_at", ""))

        from datetime import timezone as _tz
        if generated:
            try:
                gen_dt = datetime.fromisoformat(generated.replace("Z", "+00:00"))
                age_h  = (datetime.now(_tz.utc) - gen_dt).total_seconds() / 3600
            except Exception:
                age_h = 0
        else:
            age_h = (datetime.now() - datetime.fromtimestamp(week_current.stat().st_mtime)).total_seconds() / 3600

        if nb_ex == 0 and age_h > 26:
            return ('<div style="background:#e63946;color:#fff;text-align:center;'
                    'padding:6px 14px;font-size:.72rem;font-weight:700;z-index:150">'
                    f'⚠️ Sync vide il y a {int(age_h)}h — Vérifie /root/polar/tokens.json</div>')

        if age_h > 26:
            return ('<div style="background:#e63946;color:#fff;text-align:center;'
                    'padding:6px 14px;font-size:.72rem;font-weight:700;z-index:150">'
                    f'⚠️ Dernier sync il y a {int(age_h)}h — Données potentiellement obsolètes</div>')

        if nb_ex == 0:
            return ('<div style="background:#f59e0b;color:#fff;text-align:center;'
                    'padding:6px 14px;font-size:.72rem;font-weight:700;z-index:150">'
                    '⚠️ Semaine courante sans séances enregistrées</div>')

    except Exception:
        pass
    return ""

def echéances_band():
    now=now_local()
    today=now.date()
    items=""
    _MOIS=['',' jan',' fev',' mars',' avr',' mai',' juin',' juil',' aout',' sep',' oct',' nov',' dec']
    for r in sorted(load_races(), key=lambda r: r.get("date","9999")):
        try:
            dt    = datetime.strptime(r["date"], "%Y-%m-%d")
            color = r["couleur"]
            days  = (dt.date()-today).days
            date_long = f'{dt.day}{_MOIS[dt.month]} {dt.year}'
            obj   = r["objectif"].replace("Sub ","").replace("sub ","")
            rid   = r["id"]
            items += (
                f'<div onclick="openRaceEdit(\'{rid}\')"'
                f' style="display:flex;flex-direction:column;align-items:center;padding:5px 6px;'
                f'border-right:1px solid rgba(255,255,255,.08);flex:1;min-width:0;overflow:hidden;cursor:pointer">'
