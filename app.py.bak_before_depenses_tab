@app.route("/api/voyages/element/add", methods=["POST"])
def api_voyages_element_add():
    body    = request.get_json() or {}
    vid     = body.get("voyage_id","")
    el_type = body.get("type","activite")
    # Build element from payload
    el = {"id": new_id(), "type": el_type,
          "date": body.get("date",""), "moment": body.get("moment","matin")}
    # Copy all remaining fields except routing keys
    skip = {"voyage_id","type","date","moment"}
    for k, v in body.items():
        if k not in skip:
            el[k] = v
    # Auto-géocodage si pas de coords
    if el_type == "transport":
        if not el.get("coords") and el.get("ville_arrivee"):
            c = geocode_ville(el["ville_arrivee"])
            if c: el["coords"] = c
        if not el.get("coords_depart") and el.get("ville_depart"):
            c = geocode_ville(el["ville_depart"])
            if c: el["coords_depart"] = c
        if el.get("coords_depart") and el.get("coords") and not el.get("distance_km"):
            el["distance_km"] = distance_vol_oiseau(el["coords_depart"], el["coords"])
    else:
        ville = el.get("ville","")
        if not el.get("coords") and ville:
            c = geocode_ville(ville)
            if c: el["coords"] = c
    data = load_voyages()
    for v in data["voyages"]:
        if v["id"] == vid:
            v.setdefault("elements",[]).append(el)
            save_voyages(data)
            # Sync calendrier si transport
            if el_type == "transport":
                try: _cal_upsert_transport(el, vid)
                except: pass
            return jsonify({"ok":True,"id":el["id"]})
    return jsonify({"ok":False,"error":"Voyage non trouvé"})

