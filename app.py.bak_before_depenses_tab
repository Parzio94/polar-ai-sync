def api_last_sync():
    """Retourne un résumé de week_current.json (source de vérité depuis refactoring)."""
    wc = DATA / "weeks" / "week_current.json"
    if not wc.exists():
        return jsonify({"ok": False, "error": "week_current.json introuvable"})
    try:
        d = json.loads(wc.read_text())
        exs      = d.get("exercises", [])
        sleep    = d.get("sleep", [])
        recharge = d.get("recharge", [])
        summary = {
            "file":         "week_current.json",
            "week_key":     d.get("week_key", "?"),
            "generated":    d.get("generated", d.get("generated_at", "?")),
            "source":       d.get("source", "?"),
            "nb_exercises": len(exs),
            "nb_sleep":     len(sleep),
            "nb_recharge":  len(recharge),
            "exercises": [
                {
                    "id":            e.get("id"),
                    "sport":         e.get("sport"),
                    "start":         (e.get("start_time") or e.get("start-time", ""))[:10],
                    "distance_km":   round((e.get("distance") or 0) / 1000, 2),
                    "has_km_splits": bool(e.get("_km_splits") or e.get("_splits_km")),
                    "has_samples":   bool(e.get("_samples")),
                }
                for e in exs
            ],
            "sleep_dates":    [n.get("date", "?") for n in sleep],
            "recharge_dates": [r.get("date", "?") for r in recharge],
        }
        return jsonify({"ok": True, **summary})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)})


