  // Reverse geocode
  let nomLieu='';
  try{{
    const r=await fetch('/api/voyages/reverse_geocode',{{method:'POST',headers:{{'Content-Type':'application/json'}},body:JSON.stringify({{lat:parseFloat(lat),lng:parseFloat(lng)}})}});
    const d=await r.json();
    if(d.ok)nomLieu=d.nom;
  }}catch(err){{}}
  const popup=L.popup().setLatLng(e.latlng).setContent(
    '<div style="min-width:220px">'
    +'<b>📍 '+( nomLieu||lat+','+lng)+'</b><br>'
