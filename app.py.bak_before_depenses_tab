                   f'⚡ {pwr_avg}W moy</span> ')
    if d_plus or d_minus:
        parts = []
        if d_plus: parts.append(f"D+{int(d_plus)}m")
        if d_minus: parts.append(f"D-{int(d_minus)}m")
        badges += (f'<span style="background:#fff3e0;color:#b45309;font-size:.6rem;font-weight:700;padding:2px 7px;border-radius:5px">'
                   f'⛰️ {" · ".join(parts)}</span>')
    badges_html = f'<div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:5px">{badges}</div>' if badges else ""

    # Colonnes disponibles
    has_spd  = any(s.get("pace_s") for s in splits)   # pace_s → vitesse en km/h
    has_hr   = any(s.get("hr_avg") for s in splits)
    has_hrmin= any(s.get("hr_min") is not None for s in splits)
    has_hrmax= any(s.get("hr_max") is not None for s in splits)
    has_zone = has_hr
    has_cad  = any(s.get("cadence") for s in splits)
    has_elev = any(s.get("d_plus") is not None or s.get("d_minus") is not None for s in splits)
    has_pwr  = any(s.get("pwr_avg") for s in splits)

    # Vitesses min/max pour barre couleur
    speeds = []
    for s in splits:
        ps = s.get("pace_s")
        if ps and ps > 0:
            speeds.append(round(3600 / ps, 1))
    spd_min = min(speeds) if speeds else 0
    spd_range = max(1, max(speeds) - spd_min) if speeds else 1

    TH = 'padding:5px 8px;background:#1a1a2e;color:#fff;font-size:.6rem;font-weight:700;white-space:nowrap;text-align:'
    TD = 'padding:4px 7px;font-size:.63rem;border-bottom:1px solid #e8e4dc;white-space:nowrap;text-align:'

    thead = f'<tr><th style="{TH}left">Km</th>'
    if has_spd:  thead += f'<th style="{TH}left">🚴 Vitesse</th>'
    if has_zone: thead += f'<th style="{TH}center">Zone</th>'
    if has_hr:
        fc_header = "❤️ FC"
        if has_hrmin or has_hrmax: fc_header += " <span style='font-size:.52rem;opacity:.7'>(min – max)</span>"
        thead += f'<th style="{TH}center">{fc_header}</th>'
    if has_cad:  thead += f'<th style="{TH}center">🔄 Cad.</th>'
    if has_elev: thead += f'<th style="{TH}center">🏔️ D (D+·D-)</th>'
    if has_pwr:  thead += f'<th style="{TH}center">⚡ W</th>'
    thead += "</tr>"

    rows = ""
    for i, s in enumerate(splits):
        bg = "background:#f7f5f0;" if i % 2 == 0 else "background:#fff;"
        row = f'<td style="{TD}left;{bg}font-weight:800;color:#1a1a2e">km {s.get("km","?")}</td>'

        # Vitesse
        if has_spd:
            ps = s.get("pace_s")
            if ps and ps > 0:
                kmh = round(3600 / ps, 1)
                pct = round((kmh - spd_min) / spd_range * 100)
                col = "#52b788" if pct >= 60 else "#f59e0b" if pct >= 30 else "#e63946"
                bar_w = max(6, pct)
                row += (f'<td style="{TD}left;{bg}min-width:100px">'
                        f'<div style="display:flex;align-items:center;gap:5px">'
                        f'<div style="width:60px;height:5px;background:#e8e4dc;border-radius:3px;overflow:hidden">'
                        f'<div style="width:{bar_w}%;height:100%;background:{col};border-radius:3px"></div></div>'
                        f'<span style="font-size:.68rem;font-weight:800;color:{col}">{kmh}</span>'
                        f'<span style="font-size:.55rem;color:#9ca3af">km/h</span>'
                        f'</div></td>')
            else:
                row += f'<td style="{TD}left;{bg}color:#9ca3af">—</td>'

        # Zone FC
        if has_zone:
            hr = s.get("hr_avg")
            if hr:
                zl, zc = fc_zone(hr)
                row += (f'<td style="{TD}center;{bg}">'
                        f'<span style="background:{zc};color:#fff;font-size:.58rem;font-weight:800;'
                        f'padding:1px 6px;border-radius:4px">{zl}</span></td>')
            else:
                row += f'<td style="{TD}center;{bg}color:#9ca3af">—</td>'

        # FC
        if has_hr:
            hr = s.get("hr_avg")
            if hr:
                bpm = f'<span style="font-size:.65rem;font-weight:800;color:#1a1a2e">{hr}</span>'
                minmax = ""
                hmin = s.get("hr_min"); hmax = s.get("hr_max")
                if hmin is not None or hmax is not None:
                    minmax = (f' <span style="font-size:.55rem;color:#9ca3af">'
                             f'({hmin if hmin is not None else "?"}–{hmax if hmax is not None else "?"})</span>')
                row += f'<td style="{TD}center;{bg}">{bpm}{minmax}</td>'
            else:
                row += f'<td style="{TD}center;{bg}color:#9ca3af">—</td>'

        # Cadence
        if has_cad:
            cad = s.get("cadence","")
            row += f'<td style="{TD}center;{bg}font-weight:700">{int(cad) if cad else "—"}</td>'

        # Dénivelé
        if has_elev:
            dp = s.get("d_plus"); dm = s.get("d_minus")
            d_net = (round(dp) if dp else 0) - (round(dm) if dm else 0)
            if dp is not None or dm is not None:
                arrow = "↑" if d_net > 0 else "↓" if d_net < 0 else "→"
                net_col = "#15803d" if d_net > 0 else "#be123c" if d_net < 0 else "#9ca3af"
                dp_str = f"+{round(dp)}m" if dp and dp > 0.5 else ""
                dm_str = f"-{round(dm)}m" if dm and dm > 0.5 else ""
                detail = f"({dp_str}{dm_str})" if dp_str or dm_str else ""
                row += (f'<td style="{TD}center;{bg}">'
                        f'<span style="font-size:.65rem;font-weight:800;color:{net_col}">{arrow}{abs(int(d_net))}</span>'
                        f' <span style="font-size:.55rem;color:#9ca3af">{detail}</span></td>')
            else:
                row += f'<td style="{TD}center;{bg}color:#9ca3af">—</td>'

        # Puissance
        if has_pwr:
            pw = s.get("pwr_avg")
            row += f'<td style="{TD}center;{bg}font-weight:700;color:#7c3aed">{str(pw)+"W" if pw else "—"}</td>'

        rows += f"<tr>{row}</tr>"

    n = len(splits)
    max_h = "220px" if n > 8 else "auto"
    table = (f'<div style="margin-top:6px;overflow-x:auto;overflow-y:auto;max-height:{max_h}">'
             f'<table style="width:100%;border-collapse:collapse;font-size:.63rem;border-radius:8px;overflow:hidden">'
             f'<thead style="position:sticky;top:0">{thead}</thead><tbody>{rows}</tbody></table></div>')

    sid = f'cy{uid}'
    body = f'<div class="splits-body" id="{sid}" data-loaded="1">{table}</div>'

    btns = (
        f'<div style="display:flex;gap:6px;margin-top:8px;justify-content:center">'
        f'<button class="splits-btn" id="btn-{sid}" data-sid="{sid}" '
        f'onclick="var s=this.dataset.sid,b=document.getElementById(s);b.classList.toggle(\'open\');'
        f'this.innerHTML=b.classList.contains(\'open\')?\'\u25b2 Masquer d\u00e9tail km\':\'\U0001f4ca D\u00e9tail km\';">'
        f'\U0001f4ca D\u00e9tail km</button>'
        f'{graph_btn}'
        f'</div>'
    )
    return f'{btns}{body}{graph_div}'
