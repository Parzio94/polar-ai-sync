        f'<div style="font-size:.45rem;color:rgba(255,255,255,.35);margin-top:1px">Ajouter</div>'
        f'</div>'
    )
    return f'<div style="background:#23232f;display:flex;border-bottom:2px solid #111">{items}</div>'

