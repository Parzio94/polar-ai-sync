def load_hr_zones():
    """Lit les zones FC depuis hr_zones.json, fallback sur les valeurs par défaut."""
    zf = POLAR / "hr_zones.json"
    if zf.exists():
        try:
            return json.loads(zf.read_text())
        except Exception:
            pass
    return _HR_ZONES_DEFAULT

