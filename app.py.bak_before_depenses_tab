def _load_analysis():
    f = POLAR / "analysis_current.json"
    if f.exists():
        try:
            raw = f.read_text(encoding="utf-8", errors="surrogateescape")
            raw = raw.encode("utf-8", errors="replace").decode("utf-8")
            return json.loads(raw)
        except: pass
    return None

def _load_archived_analyses():
    """Charge toutes les analyses archivées analysis_S*.json triées par date desc."""
    archived = []
    for f in sorted(POLAR.glob("analysis_S*.json"), reverse=True):
        try:
            raw = f.read_text(encoding="utf-8", errors="surrogateescape")
            raw = raw.encode("utf-8", errors="replace").decode("utf-8")
            d = json.loads(raw)
            archived.append((f.name, d))
        except: pass
    return archived

def _forme_color(forme):
    return {"EN_FORME":"#2d6a4f","NORMAL":"#1565c0",
            "FATIGUE":"#f59e0b","SURCHARGE":"#e63946"}.get(forme,"#4a4a6a")

def _forme_label(forme):
    return {"EN_FORME":"🟢 En forme","NORMAL":"🔵 Normal",
            "FATIGUE":"🟡 Fatigue","SURCHARGE":"🔴 Surcharge"}.get(forme, forme or "—")

