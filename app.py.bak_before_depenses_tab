    var pr=document.getElementById('el-hotel-prix-row');
    if(pr)pr.style.display=this.value==='checkout'?'none':'';
  });
});
function voyGeocodeDebounce(key){
  clearTimeout(_geocodeTimers[key]);
  _geocodeTimers[key]=setTimeout(()=>voyGeocode(key),600);
}
var _resultsDivMap={dep:'el-dep-results',arr:'el-arr-results',hotel:'el-hotel-results',act:'el-act-results',food:'el-food-results'};
var _inputMap={dep:'el-vdep',arr:'el-varr',hotel:'el-hotel-ville',act:'el-act-ville',food:'el-food-ville'};
async function voyGeocode(key){
  const val=document.getElementById(_inputMap[key]).value.trim();
  const resDiv=document.getElementById(_resultsDivMap[key]);
  if(!val||val.length<3){if(resDiv)resDiv.style.display='none';return;}
  try{
    const r=await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=5&q='+encodeURIComponent(val),{headers:{'Accept-Language':'fr'}});
    const results=await r.json();
    if(!resDiv)return;
    if(!results.length){resDiv.style.display='none';return;}
    resDiv.innerHTML='';
    results.forEach(function(res){
      var d=document.createElement('div');
      d.style.cssText='padding:7px 10px;cursor:pointer;border-bottom:1px solid #f0ede8;background:#fff';
      var parts=res.display_name.split(',');
      d.innerHTML='<div style="font-size:.75rem;font-weight:700;color:#1a1a2e">'+parts.slice(0,2).join(', ')+'</div>'
        +'<div style="font-size:.62rem;color:#9ca3af">'+parts.slice(2,4).join(', ')+'</div>';
      d.addEventListener('click',function(){
        voySelectGeoResult(key,res.lat,res.lon,parts.slice(0,2).join(', '));
      });
      resDiv.appendChild(d);
    });
    resDiv.style.display='block';
  }catch(e){}
}
function voySelectGeoResult(key,lat,lng,label){
  _geocoords[key]={lat:parseFloat(lat),lng:parseFloat(lng)};
  const inp=document.getElementById(_inputMap[key]);
  if(inp)inp.value=label;
  const resDiv=document.getElementById(_resultsDivMap[key]);
  if(resDiv)resDiv.style.display='none';
}
